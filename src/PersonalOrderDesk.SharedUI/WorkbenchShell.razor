@namespace PersonalOrderDesk.SharedUI
<div class="desk-app">
    <aside class="desk-rail"><div class="desk-brand"><img src="_content/PersonalOrderDesk.SharedUI/app.svg" alt=""/><strong>个人接单工作台</strong></div>
        <nav aria-label="工作台导航">@foreach(var item in NavItems) { <button class="@(_page==item.Key&&_detail is null?"active":"")" @onclick='()=>Navigate(item.Key)'><DeskIcon Name="@item.Key"/><span>@item.Value</span></button> }</nav>
        <div class="desk-rail-note">数据由你自己保存<br/>本地 · 局域网 · 只读副本</div>
    </aside>
    <main class="desk-main">
        <div class="desk-source"><span class="source-dot @(Session.Profile.Mode==WorkspaceMode.PcSnapshot?"snapshot":"")"></span><strong>@Session.SourceLabel</strong>@if(Session.ReadOnly){<span>只读</span>}<button @onclick='()=>Navigate("settings")'>连接与数据</button></div>
        @if(Session.Profile.Mode==WorkspaceMode.PcSnapshot&&Session.Profile.SnapshotAt is {} time){<p class="desk-muted snapshot-time">副本更新：@time.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · 可离线修改，同步时合并两端改动</p>}
        @if(!string.IsNullOrEmpty(_error)){<div class="desk-alert danger" role="alert">@_error<button @onclick='()=>_error=null' aria-label="关闭提示">×</button></div>}
        @if(!string.IsNullOrEmpty(_notice)){<div class="desk-alert success" role="status">@_notice</div>}
        @if(_busy){<div class="desk-loading" role="status">正在处理…</div>}
        @if(_state is null){<section class="desk-card empty"><h2>@(_busy?"正在打开工作台":"数据源尚未就绪")</h2><p>保留当前数据来源，连接中断时不会自动切换账本。</p><button @onclick='Refresh' disabled="@_busy">重新加载</button><button @onclick='()=>Navigate("settings")'>连接与数据</button></section>}
        else if(_detail is not null){
            var w=_detail.Detail.WorkItem;
            <header class="desk-heading"><div><button class="back-link" @onclick='BackToList'>← 返回列表</button><h1>@w.ProjectName</h1><p class="desk-muted number">@(w.BusinessOrderNo??"未填写编号") · @TypeName(w.ProjectType)</p></div><div class="desk-actions">@if(!Session.ReadOnly){<button @onclick='()=>OpenOrderEditor(w.Id)'>编辑订单</button><button class="danger-outline" @onclick='()=>ShowDialog("delete")'>删除</button>}</div></header>
            <div class="desk-tabs"><button class="@(_detailTab=="info"?"active":"")" @onclick='()=>_detailTab="info"'>进度与资料</button><button class="@(_detailTab=="money"?"active":"")" @onclick='()=>_detailTab="money"'>收支记录</button><button class="@(_detailTab=="shipping"?"active":"")" @onclick='()=>_detailTab="shipping"'>物流</button></div>
            @if(_detailTab=="info"){
                <section class="desk-card"><div class="desk-badges"><span class="badge @StatusClass(w.Status)">@StatusName(w.Status)</span><span class="badge @(_detail.Detail.OutstandingCents>0?"red":"green")">@_detail.Detail.PaymentState</span>@if(w.IsArchived){<span class="badge gray">已归档</span>}</div><h2 class="next-line">@(w.Status is WorkStatus.Completed or WorkStatus.Cancelled ? (_detail.Detail.OutstandingCents>0?"工作已完成，待核对收款":"查看收支和物流，确认交付情况") : w.NextStep??"补充当前进度，安排下一步")</h2><div class="desk-facts"><div><span>订单金额</span><strong>@Money(w.OrderAmountCents)</strong></div><div><span>已收款</span><strong class="green-text">@Money(_detail.Money.NetReceivedCents)</strong></div><div><span>待收</span><strong class="@(_detail.Money.OutstandingCents>0?"red-text":"green-text")">@Money(_detail.Money.OutstandingCents)</strong></div><div><span>截止日期</span><strong>@(w.EffectiveDueDate?.ToString("MM-dd")??"待补")</strong></div></div></section>
                <section class="desk-card"><h2>当前进度</h2>@if(Session.ReadOnly){<p>@(w.CurrentWork??"未填写")</p><p class="desk-muted">下一步：@(w.NextStep??"未填写")</p>}else{<div class="desk-form-grid"><label>当前做到哪里<textarea @bind="_progressCurrent" rows="2" maxlength="4000"></textarea></label><label>下一步做什么<textarea @bind="_progressNext" rows="2" maxlength="2000"></textarea></label></div><button class="primary" disabled="@_busy" @onclick='SaveProgress'>保存进度</button><div class="desk-actions mt">@if(w.Status is WorkStatus.NotStarted or WorkStatus.NeedsRework){<button @onclick='()=>SetStatus(WorkStatus.InProgress)'>开始进行</button>}@if(w.Status is WorkStatus.NotStarted or WorkStatus.InProgress or WorkStatus.NeedsRework){<button @onclick='()=>SetStatus(WorkStatus.Completed)'>标记完成</button>}<details><summary>其他操作</summary><div class="desk-actions mt"><button @onclick='OpenStatusDialog'>返工 / 取消 / 恢复</button><button @onclick='()=>Archive(!w.IsArchived)'>@(w.IsArchived?"取消归档":"归档")</button><button @onclick='OpenAdditional'>追加工作</button></div></details></div>}</section>
                @if(!string.IsNullOrWhiteSpace(w.ProjectPath)||!string.IsNullOrWhiteSpace(NoteSections.CurrentNotes)){<section class="desk-card"><h2>工程与备注</h2>@if(!string.IsNullOrWhiteSpace(w.ProjectPath)){<p class="desk-path">@w.ProjectPath</p><button @onclick='()=>CopyText(w.ProjectPath)'>复制工程路径</button>}<p class="pre-line">@NoteSections.CurrentNotes</p></section>}
                @if(!string.IsNullOrWhiteSpace(NoteSections.ImportHints)){<details class="desk-card"><summary>原表资料 · 导入时的提示</summary><p class="desk-muted">以下提示记录导入当时的情况，当前状态以上方为准。</p><p class="pre-line">@NoteSections.ImportHints</p></details>}
                @if(_detail.Detail.Relations.Count>0){<section class="desk-card"><h2>关联订单</h2>@foreach(var related in _detail.Detail.Relations){<button class="link-button" @onclick='()=>OpenOrder(related.RelatedWorkItemId)'>@related.BusinessOrderNo · @related.ProjectName</button>}</section>}
                <details class="desk-card"><summary>状态历史与操作记录</summary>@foreach(var h in _detail.Detail.History){<p>@StatusName(h.NewStatus) · @(h.OccurredDate?.ToString("yyyy-MM-dd")??"历史日期未知")<span class="desk-muted"> @h.Reason</span></p>}</details>
            }else if(_detailTab=="money"){
                <div class="desk-metrics"><article><span>已收款</span><strong class="green-text">@Money(_detail.Money.NetReceivedCents)</strong></article><article><span>已记支出</span><strong>@Money(_detail.Money.TotalCostCents)</strong></article><article><span>已记利润</span><strong class="@(_detail.Money.NetReceivedCents>=_detail.Money.TotalCostCents?"green-text":"red-text")">@Money(_detail.Money.NetReceivedCents-_detail.Money.TotalCostCents)</strong></article><article><span>待收</span><strong class="red-text">@Money(_detail.Money.OutstandingCents)</strong></article></div>
                @if(!Session.ReadOnly){<div class="desk-actions sticky-actions"><button class="primary" @onclick='()=>OpenEntry("receipt")'>＋ 记收款</button><button @onclick='()=>OpenEntry("expense")'>－ 记支出</button><button class="subtle" @onclick='()=>OpenEntry("refund")'>退款</button></div>}
                <section class="desk-card"><h2>收支流水</h2>@if(Ledger.Count==0){<p class="empty">还没有收支记录。</p>}@foreach(var row in Ledger){<article class="ledger-item"><div class="ledger-heading"><span>@row.Label <small class="desk-muted">@(row.Transaction?.PaymentMethod??row.Group?.Category)</small>@if(!row.IsActive){<span class="badge gray">已撤销</span>}</span><strong class="@(row.IsActive&&row.Transaction?.Type==TransactionType.Receipt?"green-text":"") @(!row.IsActive?"struck":"")">@(row.Transaction?.Type==TransactionType.Receipt?"＋":"−")@Money(row.AmountCents)</strong></div><p class="desk-muted">@(row.Date?.ToString("yyyy-MM-dd")??"日期未填写") · @(row.Group?.Title??row.Transaction?.Notes)</p>@if(row.IsActive&&!Session.ReadOnly){<details><summary>更多</summary>@if(row.Transaction is {} pay&&pay.Allocations.Count>1){<p>整笔交易 @Money(pay.AmountCents)，撤销影响全部 @pay.Allocations.Count 个订单。</p>@foreach(var a in pay.Allocations){<p class="desk-muted">@a.BusinessOrderNo · @a.ProjectName @(a.IsDeleted?"（回收站）":"") · @Money(a.AmountCents)</p>}}<button class="danger-outline" @onclick='()=>OpenReverse(row)'>撤销这笔记录</button></details>}</article>}</section>
            }else{
                <section class="desk-card"><h2>快递与签收</h2>@if(_detail.Shipping is {} ship){<div class="desk-badges"><span class="badge blue">@ShipName(ship.ShipmentStatus)</span></div><p>快递公司：@(ship.Carrier??"未填写")</p><p>快递单号：@(ship.TrackingNumber??(ship.NoTrackingNumber==true?"明确无单号":"未填写"))</p><p>寄出日期：@(ship.ShippedDate?.ToString("yyyy-MM-dd")??"未记录") · 签收日期：@(ship.DeliveredDate?.ToString("yyyy-MM-dd")??"未记录")</p>@if(!Session.ReadOnly&&ship.ShipmentStatus==ShipmentStatus.NotShipped){<div class="desk-form-grid"><label>快递公司<input @bind="_carrier"/></label><label>快递单号<input @bind="_tracking"/></label><label>寄出日期<input type="date" @bind="_shipDate"/></label><label class="check"><input type="checkbox" @bind="_noTracking"/>明确没有快递单号</label></div><button class="primary" disabled="@(_busy||w.Status!=WorkStatus.Completed)" @onclick='Ship'>记录已寄出</button>@if(w.Status!=WorkStatus.Completed){<p class="desk-muted">完成制作后可记录寄出。</p>}}else if(!Session.ReadOnly&&ship.ShipmentStatus==ShipmentStatus.Shipped){<label>签收日期<input type="date" @bind="_deliveredDate"/></label><button class="primary" disabled="@_busy" @onclick='Deliver'>确认已签收</button>}else if(ship.ShipmentStatus==ShipmentStatus.Unknown){<p class="desk-muted">历史物流状态待核，请在电脑的高级管理里补充。</p>}}else{<p>@(w.ShippingRequirement==ShippingRequirement.None?"此项目无需快递。":"物流需求或历史资料待确认，可编辑订单或在电脑高级管理里核对。")</p>}</section>
            }
        }else if(_page=="overview"){
            <header class="desk-heading"><div><h1>概览</h1><p class="desk-muted">订单、进度和收支，一眼查看。</p></div><div class="desk-actions"><button @onclick='Refresh'>刷新</button>@if(!Session.ReadOnly){<button class="primary" @onclick='()=>OpenOrderEditor()'>＋ 新增订单</button>}</div></header>
            <div class="desk-metrics"><article><span>总单量</span><strong>@_state.Orders.Count <small>单</small></strong></article><article><span>进行中</span><strong>@_state.Orders.Count(x=>x.Status==WorkStatus.InProgress)</strong></article><article><span>已完成</span><strong class="green-text">@_state.Orders.Count(x=>x.Status==WorkStatus.Completed)</strong></article><article><span>未开始</span><strong>@_state.Orders.Count(x=>x.Status==WorkStatus.NotStarted)</strong></article></div>
            <section class="desk-card"><div class="desk-card-title"><h2>收入与利润</h2><button class="link-button" @onclick='()=>Navigate("money")'>按编号记收支 →</button></div><div class="desk-facts money-facts"><div><span>报价合计</span><strong>@Money(_state.Money.Where(x=>x.Quote.HasValue).Sum(x=>x.Quote!.Value))</strong></div><div><span>已收款</span><strong class="green-text">@Money(_state.Money.Sum(x=>x.Received))</strong></div><div><span>已记支出</span><strong>@Money(_state.Money.Sum(x=>x.Cost))</strong></div><div><span>已记利润</span><strong class="@(_state.Money.Sum(x=>x.Received-x.Cost)>=0?"green-text":"red-text")">@Money(_state.Money.Sum(x=>x.Received-x.Cost))</strong></div><div><span>待收余额</span><strong class="red-text">@Money(_state.Money.Sum(x=>x.Due??0))</strong></div></div><p class="desk-muted fine">按已登记收支计算，包含已归档，不含回收站。</p></section>
            <section class="desk-card"><h2>接下来要处理</h2>@if(TodoItems.Count==0){<p class="empty">当前没有待办，可以查看订单或新增一单。</p>}@foreach(var row in TodoItems){<button class="todo-row" @onclick='()=>OpenOrder(row.Id)'><span><strong>@row.ProjectName</strong><small>@row.BusinessOrderNo · @NextAction(row)</small></span><span class="badge @StatusClass(row.Status)">@StatusName(row.Status)</span></button>}</section>
        }else if(_page=="orders"){
            <header class="desk-heading"><div><h1>工作项</h1><p class="desk-muted">按编号找单，接着上次的进度做。</p></div>@if(!Session.ReadOnly){<button class="primary" @onclick='()=>OpenOrderEditor()'>＋ 新增订单</button>}</header>
            <div class="desk-filter"><input aria-label="搜索编号或项目名称" @bind="_search" @bind:event="oninput" placeholder="搜索编号、项目名称或关键词"/><select aria-label="工作状态" @bind="_statusFilter"><option value="">全部状态</option>@foreach(var status in Enum.GetValues<WorkStatus>()){<option value="@status">@StatusName(status)</option>}</select><label class="check"><input type="checkbox" @bind="_includeArchived"/>含归档</label></div>
            <section class="desk-card table-card"><table class="desk-table"><thead><tr><th>编号 / 项目</th><th>工作状态</th><th>进度 / 下一步</th><th>收款</th><th>操作</th></tr></thead><tbody>@foreach(var row in VisibleOrders){<tr><td class="cell-title"><button class="project-link" @onclick='()=>OpenOrder(row.Id)'>@row.ProjectName</button><small class="number">@row.BusinessOrderNo · @TypeName(row.ProjectType)</small></td><td data-label="工作状态"><span class="badge @StatusClass(row.Status)">@StatusName(row.Status)</span><small>@(row.EffectiveDueDate?.ToString("yyyy-MM-dd")??"截止日期待补")</small></td><td data-label="当前与下一步"><span>@(row.CurrentWork??(row.Status==WorkStatus.Completed?"工作已完成":"待补进度"))</span>@if(!string.IsNullOrWhiteSpace(row.NextStep)&&row.Status!=WorkStatus.Completed){<small>@row.NextStep</small>}</td><td data-label="收款"><span class="badge @(row.OutstandingCents>0?"red":"green")">@row.PaymentState</span><small class="@(row.OutstandingCents>0?"red-text":"")">待收 @Money(row.OutstandingCents)</small></td><td class="cell-actions"><button @onclick='()=>OpenOrder(row.Id,"money")'>记收支</button></td></tr>}</tbody></table>@if(!VisibleOrders.Any()){<p class="empty">没有符合条件的工作项。<button class="link-button" @onclick='ClearSearch'>清除筛选</button><button class="link-button" @onclick='()=>Navigate("recycle")'>查看回收站</button></p>}</section>
        }else if(_page=="money"){
            <header class="desk-heading"><div><h1>收支结算</h1><p class="desk-muted">按编号核对已收、支出、利润和待收。</p></div><button class="primary" disabled="@(CopyList.LineCount==0)" @onclick='CopyUnsettled'>复制未结款清单</button></header>
            <div class="desk-actions"><label class="check"><input type="checkbox" @bind="_dueOnly"/>只看未结款</label><input class="compact-search" aria-label="搜索收支编号" @bind="_moneySearch" @bind:event="oninput" placeholder="搜索编号或名称"/></div>
            <details class="desk-card mt"><summary>复制预览 · @CopyList.LineCount 个编号 · @Money(CopyList.TotalCents)</summary><p class="desk-muted">同编号追加单合并，复制剩余待收金额，每行“编号 金额”。</p><textarea class="copy-preview" readonly aria-label="未结款复制预览">@CopyList.Text</textarea>@if(CopyList.MissingNumberCount>0||CopyList.MissingAmountCount>0){<p class="red-text">另有 @CopyList.MissingNumberCount 项缺编号、@CopyList.MissingAmountCount 项金额待补，未计入清单。</p>}</details>
            <section class="desk-card table-card"><table class="desk-table money-table"><thead><tr><th>订单编号</th><th>项目名称</th><th>收款</th><th>支出</th><th>利润</th><th>待收</th></tr></thead><tbody>@foreach(var row in VisibleMoney){<tr><td data-label="编号" class="number">@(row.Number??"未编号")</td><td class="cell-title"><button class="project-link" @onclick='()=>OpenOrder(row.Id,"money")'>@row.Name</button></td><td data-label="收款" class="green-text">@Money(row.Received)</td><td data-label="支出">@Money(row.Cost)</td><td data-label="利润" class="@(row.Received>=row.Cost?"green-text":"red-text")">@Money(row.Received-row.Cost)</td><td data-label="待收" class="@(row.Due>0?"red-text":"")">@Money(row.Due)</td></tr>}</tbody></table>@if(!VisibleMoney.Any()){<p class="empty">当前范围没有未结款记录，可取消“只看未结款”查看全部收支。</p>}</section>
        }else if(_page=="shipping"){
            <header class="desk-heading"><div><h1>物流履约</h1><p class="desk-muted">实物订单单独跟进寄出与签收。</p></div><button @onclick='Refresh'>刷新</button></header><section class="desk-card">@foreach(var row in _state.Orders.Where(x=>x.FulfillmentState is not("None" or "无需快递"))){<button class="todo-row" @onclick='()=>OpenOrder(row.Id,"shipping")'><span><strong>@row.ProjectName</strong><small>@row.BusinessOrderNo</small></span><span class="badge blue">@row.FulfillmentState</span></button>}@if(!_state.Orders.Any(x=>x.FulfillmentState is not("None" or "无需快递"))){<p class="empty">当前没有需要快递的项目。</p>}</section>
        }else if(_page=="recycle"){
            <header class="desk-heading"><div><h1>回收站</h1><p class="desk-muted">恢复后，原来的状态、收支和关联记录一起保留。</p></div></header><section class="desk-card">@foreach(var row in _state.Recycle){<div class="todo-row"><span><strong>@row.ProjectName</strong><small>@row.BusinessOrderNo · @row.DeletedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></span>@if(!Session.ReadOnly){<button @onclick='()=>Restore(row)'>恢复</button>}</div>}@if(_state.Recycle.Count==0){<p class="empty">回收站是空的。</p>}</section>
        }
        @if(_page=="settings"&&_detail is null){
            @if(Session.CanSwitch){<section class="desk-card"><h2>版本与更新</h2><p class="desk-muted">当前版本 @GitHubUpdates.CurrentVersion · 从项目 GitHub 发布页获取更新</p><button disabled="@_busy" @onclick='CheckUpdate'>检查更新</button>@if(_update is not null){<p>可用版本 @_update.Version</p><p class="pre-line desk-muted">@_update.Notes</p><button class="primary" disabled="@_busy" @onclick='DownloadUpdate'>下载并校验安装包</button>}<p class="desk-muted">更新仅下载程序，不上传账本。安装前请备份；Windows需先退出后台服务，Android由系统确认安装。</p></section>}
            <header class="desk-heading"><div><h1>连接与数据</h1><p class="desk-muted">始终清楚当前使用哪一套账本。</p></div></header>
            <section class="desk-card"><h2>当前数据来源</h2><p><span class="badge @(Session.ReadOnly?"orange":"green")">@Session.SourceLabel</span></p><p class="desk-muted">切换数据来源不会合并账本；连接中断时不会自动切换。</p>@if(Session.CanSwitch){<div class="desk-actions"><button class="primary" disabled="@_busy" @onclick='UseLocal'>@(Session.IsMobile?"打开手机独立账本":"打开本机工作台")</button><button disabled="@(_busy||Session.Profile.SnapshotAt is null)" @onclick='UseSnapshot'>打开电脑离线副本</button></div>}</section>
            @if(Session.CanSwitch){<section class="desk-card"><h2>连接电脑</h2><p class="desk-muted">电脑打开工作台并允许局域网访问后，填写它显示的地址和访问密码。</p><div class="desk-form-grid"><label>电脑地址<input @bind="_serverAddress" placeholder="http://192.168.1.10:5059"/></label><label>访问密码<input type="password" @bind="_serverPassword" autocomplete="off" maxlength="128"/></label></div><button class="primary" disabled="@_busy" @onclick='ConnectPc'>连接电脑账本</button></section><section class="desk-card"><h2>双向同步电脑账本</h2><p>首次同步建立电脑副本。以后可离线修改，重新联网时预览并合并两端改动；同步前自动备份两端。手机独立账本继续单独保存。</p><p class="desk-muted">上次更新：@(Session.Profile.SnapshotAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")??"尚未同步")</p><div class="desk-actions"><button class="primary" disabled="@(_busy||Session.Profile.ServerInstance is null)" @onclick='SyncPc'>预览并同步</button><button disabled="@(_busy||Session.Profile.SnapshotAt is null)" @onclick='UseSnapshot'>打开离线副本</button></div></section>}
            @if(Session.Profile.LastSyncProtection is {} protection){<section class="desk-card"><h2>上次同步保护</h2><button disabled="@_busy" @onclick='ExportSyncBackup'>导出两端同步备份</button><p class="desk-path">@protection</p><p class="desk-muted">两端备份先完成，再合并改动；可按同步编号在电脑设置中找到保护备份，手机备份保存在应用内。</p></section>}<section class="desk-card"><h2>备份与高级管理</h2>@if(Session.IsMobile){<p class="desk-muted">独立账本备份保存在手机应用目录，可通过系统保存或分享。</p><button disabled="@(_busy||Session.Profile.Mode!=WorkspaceMode.Local)" @onclick='BackupLocal'>备份手机独立账本</button>}else{<p class="desk-muted">导入Excel、完整备份恢复、局域网密码及历史资料核对，继续使用电脑的高级管理。</p><div class="desk-actions"><button @onclick='()=>OpenAdvanced("Settings")'>设置与备份</button><button @onclick='()=>OpenAdvanced("Settings/Network")'>设置手机连接</button></div>}</section>
        }
        <footer class="desk-footer">个人接单工作台 · @Session.SourceLabel</footer>
    </main>
</div>
@if(_dialog is not null){
    <div class="desk-dialog-backdrop" @onkeydown="DialogKey" tabindex="-1"><section class="desk-dialog" role="dialog" aria-modal="true" aria-label="@DialogTitle"><div class="dialog-heading"><h2>@DialogTitle</h2><button class="icon-button" aria-label="关闭窗口" @onclick='CloseDialog' disabled="@_busy">×</button></div>
        @if(!string.IsNullOrEmpty(_dialogError)){<div class="desk-alert danger" role="alert">@_dialogError</div>}
        @if(_dialog=="sync"&&_syncReview is {} review){
            <p>电脑有 @review.PcChanges 处改动，手机有 @review.PhoneChanges 处改动。</p>
            <p class="green-text">同步前的电脑备份、手机副本备份与共同版本备份已完成。</p>
            <p class="desk-muted">没有冲突的改动会合并。手机独立账本保持单独保存。</p>
            @foreach(var warning in review.Warnings){<p class="desk-alert danger">@warning</p>}
            @if(review.Conflicts.Count==0){<p>没有发现字段冲突，确认后将合并并更新两端。</p>}
            @foreach(var conflict in review.Conflicts){<section class="sync-conflict"><strong>@conflict.Project</strong><h3>@conflict.Field</h3><p class="desk-muted">共同版本：@conflict.Baseline</p><p><b>电脑：</b>@conflict.Pc</p><p><b>手机：</b>@conflict.Phone</p><label>保留哪一端的内容<select @bind="_syncChoices[conflict.Id]"><option value="">请选择</option><option value="pc">保留电脑内容</option><option value="phone">保留手机内容</option></select></label></section>}
            <label class="check"><input type="checkbox" @bind="_confirmAction"/>我已核对改动与收支记录，确认合并</label>
            <div class="dialog-footer"><button class="primary" disabled="@(_busy||!_confirmAction||_syncChoices.Values.Any(x=>x==""))" @onclick='CommitSync'>确认合并并同步</button><button disabled="@_busy" @onclick='CloseDialog'>取消</button></div>
        }else if(_dialog=="order"){
            <label>项目名称<input @bind="_editName" maxlength="200" autofocus/></label><div class="desk-form-grid"><label>订单编号<input @bind="_editNumber" maxlength="120"/></label><label>项目类型<select @bind="_editType">@foreach(var t in Enum.GetValues<ProjectType>()){<option value="@t">@TypeName(t)</option>}</select></label><label>接单日期<input type="date" @bind="_editReceived"/></label><label>订单金额（元）<input type="number" step="0.01" min="0" @bind="_editQuote"/></label><label>截止规则<select @bind="_editDueMode"><option value="Auto">非实物自动：接单后一天</option><option value="Manual">手动指定</option>@if(_editBase?.SourceKind==SourceKind.HistoricalImport){<option value="HistoricalUnknown">历史日期未知</option>}</select></label>@if(_editDueMode==DueDateMode.Manual){<label>约定交付日期<input type="date" @bind="_editDue"/></label>}</div>
            @if(_editType==ProjectType.PhysicalProduction&&_editDueMode==DueDateMode.Auto){<p class="orange-text">实物工期请按约定填写，选择“手动指定”并填写交付日。</p>}
            @if(_editId.HasValue&&_editBase?.ProjectType!=_editType){<label>项目类型变化后<select @bind="_typeDefaults"><option value="">请选择</option><option value="apply">应用新类型的工期与物流默认值</option><option value="keep">保留现有工期和物流</option></select></label>}
            @if(_editId.HasValue&&QuoteChanged){<label>金额修改原因<input @bind="_editAmountReason" maxlength="500"/></label>}
            <details><summary>进度、工程与备注（选填）</summary><label>当前工作<textarea @bind="_editCurrent" maxlength="4000"></textarea></label><label>下一步<textarea @bind="_editNext" maxlength="2000"></textarea></label><label>工程文件夹<input @bind="_editPath" maxlength="1000"/></label><label>当前备注<textarea @bind="_editNotes" maxlength="5000"></textarea></label><label>物流需求<select @bind="_editShipping"><option value="">按类型默认 / 保持当前值</option><option value="None">无需快递</option><option value="Required">需要快递</option><option value="Pending">待确认</option></select></label></details><div class="dialog-footer"><button class="primary" disabled="@_busy" @onclick='SaveOrder'>保存订单</button><button @onclick='CloseDialog' disabled="@_busy">取消</button></div>
        }else if(_dialog is "receipt" or "refund" or "expense"){
            <p class="desk-muted">@_detail?.Detail.WorkItem.BusinessOrderNo · @_detail?.Detail.WorkItem.ProjectName</p><label>@(_dialog=="expense"?"支出金额（元）":_dialog=="refund"?"退款金额（元）":"收款金额（元）")<input class="entry-money" type="number" step="0.01" min="0.01" @bind="_entryAmount" autofocus/></label><div class="desk-form-grid">@if(_dialog=="expense"){<label>支出分类<select @bind="_expenseCategory"><option>材料</option><option>快递</option><option>外包</option><option>其他</option></select></label>}else{<label>收付方式<select @bind="_paymentMethod"><option value="">未选择</option><option>微信</option><option>支付宝</option><option>银行卡</option><option>现金</option><option>其他</option></select></label>}<label>日期（可留空）<input type="date" @bind="_entryDate"/></label></div>@if(_paymentMethod=="其他"&&_dialog!="expense"){<label>自定义收付方式<input @bind="_customMethod"/></label>}<label>备注（选填）<input @bind="_entryNote"/></label><div class="dialog-footer"><button class="primary" disabled="@_busy" @onclick='SaveEntry'>保存@(_dialog=="expense"?"支出":_dialog=="refund"?"退款":"收款")</button><button @onclick='CloseDialog' disabled="@_busy">取消</button></div>
        }else if(_dialog=="delete"){
            <p>将“@_detail?.Detail.WorkItem.ProjectName”（@_detail?.Detail.WorkItem.BusinessOrderNo）移入回收站。</p><p>此项目会从日常列表、待办和收支统计中移除，收支与物流记录保留，恢复后重新计入。工程文件保留。</p><p>当前净收 @Money(_detail?.Money.NetReceivedCents)，有效支出 @Money(_detail?.Money.TotalCostCents)。其他关联订单继续保留。</p><label class="check"><input type="checkbox" @bind="_confirmAction"/>我已核对，确认移入回收站</label><div class="dialog-footer"><button class="danger-button" disabled="@(_busy||!_confirmAction)" @onclick='DeleteOrder'>确认删除</button><button @onclick='CloseDialog' disabled="@_busy">取消</button></div>
        }else if(_dialog=="reverse"){
            <p>撤销 @Money(_reverseRow?.AmountCents) @_reverseRow?.Label，保留原记录和撤销原因。</p>@if(_reverseRow?.Transaction is {} t&&t.Allocations.Count>1){<p class="red-text">这是合并交易，撤销整笔 @Money(t.AmountCents)，影响全部 @t.Allocations.Count 个订单（包括回收站份额）。</p>}<label>撤销原因<input @bind="_actionReason" maxlength="500"/></label><label class="check"><input type="checkbox" @bind="_confirmAction"/>确认撤销</label><div class="dialog-footer"><button class="danger-button" disabled="@(_busy||!_confirmAction)" @onclick='Reverse'>确认撤销</button><button @onclick='CloseDialog' disabled="@_busy">取消</button></div>
        }else if(_dialog=="status"){
            <label>目标状态<select @bind="_targetStatus">@foreach(var status in AllowedStatuses){<option value="@status">@StatusName(status)</option>}</select></label><label>原因（返工、取消请填写）<input @bind="_actionReason" maxlength="500"/></label>@if(_targetStatus==WorkStatus.Cancelled){<label class="check"><input type="checkbox" @bind="_confirmAction"/>确认取消，保留收支与物流记录</label>}<div class="dialog-footer"><button class="primary" disabled="@_busy" @onclick='SaveStatus'>保存状态</button><button @onclick='CloseDialog' disabled="@_busy">取消</button></div>
        }
    </section></div>
}
@if(_receiptAnimation is not null){<div class="desk-receipt" role="status">收款已记录 <strong>＋@_receiptAnimation</strong></div>}



