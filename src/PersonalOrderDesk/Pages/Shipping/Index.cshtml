@page
@model PersonalOrderDesk.Pages.Shipping.IndexModel
@using PersonalOrderDesk.Domain
@using PersonalOrderDesk.Services
@{
    ViewData["Title"] = "物流履约";
    string StatusLabel(ShipmentStatus? s) => s switch { null => "尚无物流记录", ShipmentStatus.NotShipped => "未寄出", ShipmentStatus.Shipped => "已寄出", ShipmentStatus.Delivered => "已签收", _ => "历史物流待核对" };
    string WorkLabel(WorkStatus s) => s switch { WorkStatus.Completed => "已完成", WorkStatus.Cancelled => "已取消", WorkStatus.InProgress => "进行中", WorkStatus.NeedsRework => "需返工", _ => "未开始" };
    string CardClass(string urgency) => urgency.Contains("逾期") ? "overdue" : urgency.Contains("今日") ? "due-soon" : urgency.Contains("核对") ? "review" : "";
}
<div class="page-heading"><div><h1>物流履约</h1><p>跟进待寄、临期与逾期寄件，并核对历史物流资料；制作进度与物流信息分别记录。</p></div><a class="btn btn-outline-primary" asp-page="/WorkItems/Index">返回工作项</a></div>
<nav class="inline-actions mb-3" aria-label="物流队列筛选">
    <a class="btn @(Model.View == "All" ? "btn-primary" : "btn-outline-secondary")" asp-route-view="All">全部物流记录</a>
    <a class="btn @(Model.View == "ToShip" ? "btn-primary" : "btn-outline-secondary")" asp-route-view="ToShip">待寄出</a>
    <a class="btn @(Model.View == "Overdue" ? "btn-primary" : "btn-outline-secondary")" asp-route-view="Overdue">寄出已逾期</a>
    <a class="btn @(Model.View == "Shipped" ? "btn-primary" : "btn-outline-secondary")" asp-route-view="Shipped">已寄出 / 已签收</a>
    <a class="btn @(Model.View == "NeedsConfirmation" ? "btn-primary" : "btn-outline-secondary")" asp-route-view="NeedsConfirmation">需求待确认</a>
    <a class="btn @(Model.View == "History" ? "btn-primary" : "btn-outline-secondary")" asp-route-view="History">历史物流待核对</a>
</nav>
@if (Model.Items.Count == 0) { <div class="surface empty-state">此队列目前没有项目。</div> }
else
{
    <div class="shipping-queue">
    @foreach (var item in Model.Items)
    {
        <article class="shipping-queue-item @CardClass(item.ShippingUrgency)">
            <div class="d-flex flex-wrap justify-content-between gap-2">
                <div><h2 class="h5 mb-1">@if (item.ShippingRequirement == ShippingRequirement.Pending) { <a asp-page="/WorkItems/Edit" asp-route-id="@item.WorkItemId">@item.ProjectName</a> } else { <a asp-page="/Shipping/Details" asp-route-id="@item.WorkItemId">@item.ProjectName</a> }</h2><div class="small text-secondary">@(item.BusinessOrderNo ?? "未填写编号") · 工作：@WorkLabel(item.WorkStatus) · 物流：@StatusLabel(item.ShipmentStatus)</div></div>
                <div class="inline-actions"><span class="status-badge status-shipping">@item.ShippingUrgency</span>@if (item.IsArchived) { <span class="status-badge status-work cancelled">已归档</span> }</div>
            </div>
            <div class="work-meta"><span>物流需求：@(item.ShippingRequirement == ShippingRequirement.Required ? "需要快递" : "待确认")</span><span>最迟寄出：@(item.LatestShipDate?.ToString("yyyy-MM-dd") ?? "未设置")</span><span>承运商：@(item.Carrier ?? "未填写")</span><span>单号：@(item.TrackingNumber ?? (item.NoTrackingNumber == true ? "明确无单号" : "未填写"))</span>@if (item.FulfillmentPaused) { <span class="text-warning-emphasis fw-semibold">履约已暂停</span> }@if (item.ShipmentStatus is null && item.SourceKind == SourceKind.HistoricalImport && item.ShippingRequirement == ShippingRequirement.Required) { <span class="status-badge status-missing">需准备历史核对</span> }</div>
        </article>
    }
    </div>
}
