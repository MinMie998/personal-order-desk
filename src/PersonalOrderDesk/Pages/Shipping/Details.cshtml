@page "Details/{id:guid}"
@model PersonalOrderDesk.Pages.Shipping.DetailsModel
@using PersonalOrderDesk.Domain
@using PersonalOrderDesk.Services
@{
    var d = Model.Draft;
    var w = Model.WorkItem!.WorkItem;
    var dateCorrectionHeading = d?.SourceKind == SourceKind.HistoricalImport ? "补录历史日期" : "修正已记日期";
    ViewData["Title"] = "物流详情 · " + w.ProjectName;
    string StatusLabel(ShipmentStatus? s) => s switch { null => "尚无物流记录", ShipmentStatus.NotShipped => "未寄出", ShipmentStatus.Shipped => "已寄出", ShipmentStatus.Delivered => "已签收", _ => "历史状态未知，待核对" };
    string DateKnowledgeLabel(DateKnowledge k) => k switch { DateKnowledge.Known => "日期已知", DateKnowledge.Unknown => "日期未知", _ => "不适用" };
}
<div class="page-heading"><div><h1>物流详情</h1><p><a asp-page="/WorkItems/Details" asp-route-id="@w.Id">@w.ProjectName</a> · @(w.BusinessOrderNo ?? "未填写编号") · 工作项版本 @(d?.Version ?? w.Version)</p></div><a class="btn btn-outline-secondary" asp-page="/Shipping/Index">返回物流队列</a></div>
@if (TempData["Notice"] is string notice) { <div class="alert alert-success" role="status">@notice</div> }
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div> }
@if (d is null)
{
    @if (w.SourceKind == SourceKind.HistoricalImport && w.ShippingRequirement == ShippingRequirement.Required)
    {
        <section class="surface shipping-action"><h2 class="h5">这条历史记录还没有物流事实</h2><p>不能把它当作未寄出或已寄出。若有来源依据，请先建立历史核对，再明确选择状态与日期知识。</p><form method="post" asp-page-handler="PrepareHistoryReview"><input type="hidden" name="DraftInput.ExpectedVersion" value="@w.Version" /><button class="btn btn-primary" type="submit">准备历史物流核对</button></form></section>
    }
    else if (w.ShippingRequirement == ShippingRequirement.Pending)
    {
        <section class="surface shipping-action"><h2 class="h5">物流需求待确认</h2><p>请先确认是否需要快递。确认后，物流记录会由服务创建。</p><a class="btn btn-primary" asp-page="/WorkItems/Edit" asp-route-id="@w.Id">确认物流需求</a></section>
    }
    else
    {
        <section class="surface empty-state">此工作项没有物流记录。物流事实未被推断或创建。</section>
    }
}
else
{
<div class="row g-3">
    <div class="col-lg-5">
        <section class="surface mb-3"><div class="surface-header"><h2 class="h5 mb-0">已记录物流事实</h2></div><div class="surface-body">
            <p><span class="status-badge status-work">工作：@(w.Status switch { WorkStatus.Completed => "已完成", WorkStatus.Cancelled => "已取消", WorkStatus.InProgress => "进行中", WorkStatus.NeedsRework => "需返工", _ => "未开始" })</span> <span class="status-badge status-shipping">物流：@StatusLabel(d.ShipmentStatus)</span></p>
            <dl class="detail-grid">
                <div class="detail-item"><dt>承运商</dt><dd>@(d.Carrier ?? "未填写")</dd></div>
                <div class="detail-item"><dt>单号状态</dt><dd>@(d.TrackingNumber ?? (d.NoTrackingNumber == true ? "明确无单号" : "未知 / 未填写"))</dd></div>
                <div class="detail-item"><dt>最迟寄出日期</dt><dd>@(d.LatestShipDate?.ToString("yyyy-MM-dd") ?? "未设置")</dd></div>
                <div class="detail-item"><dt>寄出日期</dt><dd>@(d.ShippedDate?.ToString("yyyy-MM-dd") ?? "未记录")（@DateKnowledgeLabel(d.ShippedDateKnowledge)）</dd></div>
                <div class="detail-item"><dt>签收日期</dt><dd>@(d.DeliveredDate?.ToString("yyyy-MM-dd") ?? "未记录")（@DateKnowledgeLabel(d.DeliveredDateKnowledge)）</dd></div>
                <div class="detail-item"><dt>履约</dt><dd>@(d.FulfillmentPaused ? "已暂停" : "未暂停") @if (d.IsArchived) { <span>· 已归档</span> }</dd></div>
            </dl>
        </div></section>
        @if (d.ShipmentStatus == ShipmentStatus.NotShipped)
        {
            <section class="surface mb-3"><div class="surface-header"><h2 class="h5 mb-0">物流草稿</h2></div><div class="surface-body">
                <form method="post" asp-page-handler="SaveDraft">
                    <input asp-for="DraftInput.ExpectedVersion" type="hidden" />
                    <div class="mb-3"><label asp-for="DraftInput.Carrier" class="form-label">承运商</label><input asp-for="DraftInput.Carrier" class="form-control" /></div>
                    <div class="mb-3"><label asp-for="DraftInput.TrackingNumber" class="form-label">快递单号草稿</label><input asp-for="DraftInput.TrackingNumber" class="form-control" /></div>
                    <div class="mb-3"><label asp-for="DraftInput.NoTrackingNumber" class="form-label">单号状态</label><select asp-for="DraftInput.NoTrackingNumber" class="form-select"><option value="">未确认</option><option value="false">有单号</option></select><div class="form-text">未寄出时可先保存单号草稿；是否无单号只在标记寄出时明确选择。</div></div>
                    <div class="mb-3"><label asp-for="DraftInput.LatestShipDate" class="form-label">最迟寄出日期</label><input asp-for="DraftInput.LatestShipDate" type="date" class="form-control" /></div>
                    @if (w.Status == WorkStatus.Cancelled) { <div class="form-check mb-3"><input asp-for="DraftInput.FulfillmentPaused" class="form-check-input" /><label asp-for="DraftInput.FulfillmentPaused" class="form-check-label">保持物流履约暂停</label><div class="form-text">取消后的默认状态为暂停；取消勾选将明确继续履约。</div></div> }
                    <button class="btn btn-outline-primary" type="submit">保存物流草稿</button>
                </form>
            </div></section>
        }
    </div>
    <div class="col-lg-7">
        @if (d.ShipmentStatus == ShipmentStatus.Unknown)
        {
            <section class="surface mb-3"><div class="surface-header"><h2 class="h5 mb-0">核对历史物流</h2></div><div class="surface-body">
                <div class="accounting-note mb-3">只录入来源可以证实的物流状态与日期。若状态已知但日期未知，分别选择“已知状态”和“日期未知”，不要填入今天。</div>
                <form method="post" asp-page-handler="Reconcile">
                    <input asp-for="ReconcileInput.ExpectedVersion" type="hidden" />
                    <div class="row g-3">
                        <div class="col-md-6"><label asp-for="ReconcileInput.Status" class="form-label">已核实状态</label><select asp-for="ReconcileInput.Status" class="form-select"><option value="NotShipped">明确未寄出</option><option value="Shipped">已寄出</option><option value="Delivered">已签收</option></select></div>
                        <div class="col-md-6"><label asp-for="ReconcileInput.Carrier" class="form-label">承运商</label><input asp-for="ReconcileInput.Carrier" class="form-control" /></div>
                        <div class="col-md-6"><label asp-for="ReconcileInput.ShippedDateKnowledge" class="form-label">寄出日期知识</label><select asp-for="ReconcileInput.ShippedDateKnowledge" class="form-select"><option value="Unknown">日期未知</option><option value="Known">日期已知</option><option value="NotApplicable">不适用（仅未寄出）</option></select></div>
                        <div class="col-md-6"><label asp-for="ReconcileInput.ShippedDate" class="form-label">寄出日期</label><input asp-for="ReconcileInput.ShippedDate" type="date" class="form-control" /></div>
                        <div class="col-md-6"><label asp-for="ReconcileInput.DeliveredDateKnowledge" class="form-label">签收日期知识</label><select asp-for="ReconcileInput.DeliveredDateKnowledge" class="form-select"><option value="Unknown">日期未知</option><option value="Known">日期已知</option><option value="NotApplicable">不适用（未签收）</option></select></div>
                        <div class="col-md-6"><label asp-for="ReconcileInput.DeliveredDate" class="form-label">签收日期</label><input asp-for="ReconcileInput.DeliveredDate" type="date" class="form-control" /></div>
                        <div class="col-md-6"><label asp-for="ReconcileInput.TrackingNumber" class="form-label">快递单号</label><input asp-for="ReconcileInput.TrackingNumber" class="form-control" /></div>
                        <div class="col-md-6"><label asp-for="ReconcileInput.NoTrackingNumber" class="form-label">单号状态</label><select asp-for="ReconcileInput.NoTrackingNumber" class="form-select"><option value="">未知 / 未确认</option><option value="true">明确无单号</option><option value="false">有单号</option></select></div>
                        <div class="col-12"><label asp-for="ReconcileInput.Reason" class="form-label">核对依据或原因</label><textarea asp-for="ReconcileInput.Reason" class="form-control" rows="2" required></textarea></div>
                    </div>
                    <button class="btn btn-primary mt-3" type="submit">保存历史核对</button>
                </form>
            </div></section>
        }
        @if (d.ShipmentStatus == ShipmentStatus.NotShipped && d.ShippingRequirement == ShippingRequirement.Required && (w.Status == WorkStatus.Completed || (w.Status == WorkStatus.Cancelled && !d.FulfillmentPaused)))
        {
            <section class="surface mb-3"><div class="surface-header"><h2 class="h5 mb-0">记录寄出</h2></div><div class="surface-body">
                <form method="post" asp-page-handler="MarkShipped">
                    <input asp-for="ShippedInput.ExpectedVersion" type="hidden" />
                    <div class="row g-3"><div class="col-md-6"><label asp-for="ShippedInput.ShippedDate" class="form-label">实际寄出日期</label><input asp-for="ShippedInput.ShippedDate" type="date" class="form-control" max="@Model.BusinessToday.ToString("yyyy-MM-dd")" required /></div><div class="col-md-6"><label asp-for="ShippedInput.Carrier" class="form-label">承运商</label><input asp-for="ShippedInput.Carrier" class="form-control" /></div><div class="col-md-6"><label asp-for="ShippedInput.TrackingNumber" class="form-label">快递单号</label><input asp-for="ShippedInput.TrackingNumber" class="form-control" /></div><div class="col-md-6"><label asp-for="ShippedInput.NoTrackingNumber" class="form-label">无单号</label><select asp-for="ShippedInput.NoTrackingNumber" class="form-select" required><option value="">请选择</option><option value="true">明确无单号</option><option value="false">有单号</option></select></div></div>
                    <button class="btn btn-primary mt-3" type="submit">确认已寄出</button>
                </form>
            </div></section>
        }
        @if (d.ShipmentStatus == ShipmentStatus.Shipped && d.ShippedDate.HasValue)
        {
            <section class="surface mb-3"><div class="surface-header"><h2 class="h5 mb-0">记录签收</h2></div><div class="surface-body">
                <form method="post" asp-page-handler="MarkDelivered"><input asp-for="DeliveredInput.ExpectedVersion" type="hidden" /><div class="mb-3"><label asp-for="DeliveredInput.DeliveredDate" class="form-label">实际签收日期</label><input asp-for="DeliveredInput.DeliveredDate" type="date" class="form-control" min="@d.ShippedDate.Value.ToString("yyyy-MM-dd")" max="@Model.BusinessToday.ToString("yyyy-MM-dd")" required /></div><button class="btn btn-primary" type="submit">确认已签收</button></form>
            </div></section>
        }
        @if (d.ShipmentStatus is ShipmentStatus.Shipped or ShipmentStatus.Delivered)
        {
            <section class="surface"><div class="surface-header"><h2 class="h5 mb-0">@dateCorrectionHeading</h2></div><div class="surface-body">
                <p class="small text-secondary">填写已核实的实际寄出或签收日期。留空会保留当前值；日期未知不会自动填今天。</p>
                <form method="post" asp-page-handler="Backfill">
                    <input asp-for="BackfillInput.ExpectedVersion" type="hidden" />
                    <div class="row g-3"><div class="col-md-6"><label asp-for="BackfillInput.ShippedDate" class="form-label">寄出日期</label><input asp-for="BackfillInput.ShippedDate" type="date" class="form-control" max="@Model.BusinessToday.ToString("yyyy-MM-dd")" /></div>@if (d.ShipmentStatus == ShipmentStatus.Delivered) { <div class="col-md-6"><label asp-for="BackfillInput.DeliveredDate" class="form-label">签收日期</label><input asp-for="BackfillInput.DeliveredDate" type="date" class="form-control" max="@Model.BusinessToday.ToString("yyyy-MM-dd")" /></div> }</div>
                    <button class="btn btn-outline-primary mt-3" type="submit">@(d.SourceKind == SourceKind.HistoricalImport ? "补录历史日期" : "保存日期修正")</button>
                </form>
            </div></section>
        }
        @if (w.Status == WorkStatus.Cancelled && d.FulfillmentPaused) { <div class="alert alert-warning">取消状态下履约已暂停。可在左侧草稿表单中取消“保持物流履约暂停”并保存，以明确继续履行。</div> }
        @if (w.Status != WorkStatus.Completed && w.Status != WorkStatus.Cancelled && d.ShipmentStatus == ShipmentStatus.NotShipped) { <div class="accounting-note">工作尚未完成，因此尚未进入待寄出阶段。可以先保存承运商、单号草稿和最迟寄出日期。</div> }
    </div>
</div>
}
