@page "WorkItem/{id:guid}"
@model PersonalOrderDesk.Pages.Finance.WorkItemModel
@using PersonalOrderDesk.Domain
@using PersonalOrderDesk.Services
@using PersonalOrderDesk.Presentation
@{
    var f = Model.Finance!;
    var w = Model.WorkItem!.WorkItem;
    var handler = Request.Query["handler"].ToString();
    var hasError = !string.IsNullOrWhiteSpace(Model.ErrorMessage) || !ViewData.ModelState.IsValid;
    var ledger = FinanceLedgerRow.From(f);
    ViewData["Title"] = $"收支 · {f.ProjectName}";
    string Money(long? cents) => cents is null ? "待补资料" : $"¥{cents.Value / 100m:N2}";
    string CostLabel(CostConfirmationStatus status) => status switch { CostConfirmationStatus.ConfirmedNoCost => "已确认无成本", CostConfirmationStatus.ConfirmedComplete => "成本已确认完整", _ => "待确认" };
    string DateLabel(DateOnly? date, DateKnowledge knowledge) => knowledge switch { DateKnowledge.Unknown => "日期未填写", DateKnowledge.NotApplicable => "不适用", _ => date?.ToString("yyyy-MM-dd") ?? "待补日期" };
}
<div class="page-heading"><div><h1>订单收支</h1><p><span class="project-number">@(f.BusinessOrderNo ?? "未填写业务编号")</span> · @f.ProjectName</p></div><a class="btn btn-outline-secondary" asp-page="/WorkItems/Details" asp-route-id="@f.WorkItemId">返回订单</a></div>
@if (TempData["Notice"] is string notice) { <div class="alert alert-success" role="status">@notice</div> }
@if (TempData["RefundRecorded"] is string) { <div class="alert alert-info">如果这次是降价退差价，可同时调整订单金额。<a asp-page="/WorkItems/Edit" asp-route-id="@f.WorkItemId">修改最终报价</a>；退款本身不会改变报价。</div> }
@if (hasError) { <div class="alert alert-danger" role="alert">@Model.ErrorMessage<div asp-validation-summary="All"></div></div> }
<div class="finance-metrics mb-3"><div class="finance-metric"><span>订单金额</span><strong>@Money(f.OrderAmountCents)</strong></div><div class="finance-metric received-money"><span>已收款（扣除退款）</span><strong>@Money(f.NetReceivedCents)</strong></div><div class="finance-metric"><span>已记支出</span><strong>@Money(f.TotalCostCents)</strong></div><div class="finance-metric"><span>已记利润</span><strong class="@(f.NetReceivedCents >= f.TotalCostCents ? "text-success" : "text-danger")">@Money(f.NetReceivedCents - f.TotalCostCents)</strong></div></div>
<div class="bookkeeping-toolbar surface mb-3">
    <div class="inline-actions"><button type="button" class="btn btn-primary" data-dialog-target="payment-editor" data-payment-type="Receipt">＋ 记收款</button><button type="button" class="btn btn-outline-primary" data-dialog-target="expense-editor">－ 记支出</button></div>
    <div class="bookkeeping-balance">待收 <strong class="@(f.OutstandingCents > 0 ? "text-danger" : "text-success")">@Money(f.OutstandingCents)</strong>@if (f.OverpaidCents > 0) { <span class="text-danger"> · 超收 @Money(f.OverpaidCents)，请核对</span> }</div>
</div>
<details class="secondary-actions mb-3"><summary>退款与其他记账方式</summary><div class="inline-actions mt-2"><button type="button" class="btn btn-sm btn-outline-secondary" data-dialog-target="payment-editor" data-payment-type="Refund">记录退款</button><a class="btn btn-sm btn-outline-secondary" asp-page="/Finance/Transactions/Create" asp-route-workItemId="@f.WorkItemId">多个订单合并收款</a></div></details>
<dialog class="entry-dialog" id="payment-editor" data-reopen="@(hasError && handler == "CreateTransaction" ? "true" : "false")" aria-labelledby="payment-editor-title">
    <div class="entry-dialog-heading"><h2 id="payment-editor-title">@(Model.PaymentInput.Type == TransactionType.Refund ? "记退款" : "记收款")</h2><button type="button" class="dialog-close" data-close-dialog aria-label="关闭记账窗口">×</button></div>
    <p class="small text-secondary">@(f.BusinessOrderNo ?? "未填写编号") · @f.ProjectName</p>
    @if (hasError && handler == "CreateTransaction") { <div class="alert alert-danger" role="alert">@Model.ErrorMessage<div asp-validation-summary="All"></div></div> }
    <form method="post" asp-page-handler="CreateTransaction">
        <input type="hidden" name="id" value="@f.WorkItemId"/><input asp-for="PaymentInput.Type" type="hidden"/><input asp-for="PaymentInput.IdempotencyKey" type="hidden"/>
        <div class="mb-3"><label asp-for="PaymentInput.AmountYuan" class="form-label" id="payment-amount-label">@(Model.PaymentInput.Type == TransactionType.Refund ? "退款金额（元）" : "收款金额（元）")</label><input asp-for="PaymentInput.AmountYuan" type="number" min="0.01" step="0.01" class="form-control entry-amount" required data-entry-focus/></div>
        <div class="row g-3"><div class="col-sm-6"><label asp-for="PaymentInput.PaymentMethod" class="form-label">收付方式</label><select asp-for="PaymentInput.PaymentMethod" class="form-select payment-method"><option value="">未选择</option><option>微信</option><option>支付宝</option><option>银行卡</option><option>现金</option><option>其他</option></select><input asp-for="PaymentInput.CustomPaymentMethod" class="form-control mt-2 custom-payment-method" placeholder="自定义收付方式" hidden/></div><div class="col-sm-6"><label asp-for="PaymentInput.TransactionDate" class="form-label">日期（可不填）</label><input asp-for="PaymentInput.TransactionDate" type="date" max="@Model.BusinessToday.ToString("yyyy-MM-dd")" class="form-control"/></div></div>
        <details class="optional-fields mt-3"><summary>参考号与备注（选填）</summary><label asp-for="PaymentInput.ExternalReference" class="form-label mt-2">外部参考号</label><input asp-for="PaymentInput.ExternalReference" class="form-control"/><label asp-for="PaymentInput.Notes" class="form-label mt-2">备注</label><input asp-for="PaymentInput.Notes" class="form-control"/></details>
        <div class="entry-dialog-footer"><button class="btn btn-primary" type="submit" id="payment-save">@(Model.PaymentInput.Type == TransactionType.Refund ? "保存退款" : "保存收款")</button><button class="btn btn-outline-secondary" type="button" data-close-dialog>取消</button></div>
    </form>
</dialog>
<dialog class="entry-dialog" id="expense-editor" data-reopen="@(hasError && handler == "QuickExpense" ? "true" : "false")" aria-labelledby="expense-editor-title">
    <div class="entry-dialog-heading"><h2 id="expense-editor-title">记支出</h2><button type="button" class="dialog-close" data-close-dialog aria-label="关闭支出窗口">×</button></div><p class="small text-secondary">@(f.BusinessOrderNo ?? "未填写编号") · @f.ProjectName</p>
    @if (hasError && handler == "QuickExpense") { <div class="alert alert-danger" role="alert">@Model.ErrorMessage<div asp-validation-summary="All"></div></div> }
    <form method="post" asp-page-handler="QuickExpense"><input type="hidden" name="id" value="@f.WorkItemId"/><input name="QuickExpense.ExpectedVersion" type="hidden" value="@w.Version"/>
        <div class="mb-3"><label asp-for="QuickExpense.Amount" class="form-label">支出金额（元）</label><input asp-for="QuickExpense.Amount" type="number" min="0.01" step="0.01" class="form-control entry-amount" required data-entry-focus/></div>
        <div class="row g-3"><div class="col-sm-6"><label asp-for="QuickExpense.Category" class="form-label">支出分类</label><select asp-for="QuickExpense.Category" class="form-select"><option>材料</option><option>快递</option><option>外包</option><option>其他</option></select></div><div class="col-sm-6"><label asp-for="QuickExpense.Date" class="form-label">日期（可不填）</label><input asp-for="QuickExpense.Date" type="date" max="@Model.BusinessToday.ToString("yyyy-MM-dd")" class="form-control"/></div></div>
        <label asp-for="QuickExpense.Note" class="form-label mt-3">备注（可不填）</label><input asp-for="QuickExpense.Note" class="form-control"/><p class="form-text">填写实际花掉的钱，保存后直接更新利润。</p>
        <div class="entry-dialog-footer"><button class="btn btn-primary" type="submit">保存支出</button><button class="btn btn-outline-secondary" type="button" data-close-dialog>取消</button></div>
    </form>
</dialog>
<section class="surface mb-3"><div class="surface-header"><h2 class="h5 mb-0">收支流水</h2><span class="small text-secondary">按业务日期倒序，未填日期列在末尾；已撤销记录保留供核对。</span></div><div class="surface-body ledger-list">
@if (ledger.Count == 0) { <p class="empty-state">还没有收支记录。用上方按钮记下第一笔。</p> }
@foreach (var row in ledger)
{
    var isReceipt = row.Transaction?.Type == TransactionType.Receipt;
    <article class="ledger-row @(!row.IsActive ? "ledger-reversed" : "")">
        <div class="ledger-row-heading"><div><strong>@row.Label</strong><span class="small text-secondary ms-2">@(row.Transaction?.PaymentMethod ?? row.Group?.Category ?? "未填写方式")</span>@if (!row.IsActive) { <span class="status-badge status-work cancelled ms-2">已撤销</span> } else if (row.Expense?.PaymentStatus == ExpensePaymentStatus.Unpaid) { <span class="status-badge ms-2">未支付</span> }</div><strong class="ledger-amount @(row.IsActive && isReceipt ? "text-success" : "")">@(isReceipt ? "+" : "−")@Money(row.AmountCents)</strong></div>
        <div class="small text-secondary">@(row.Date?.ToString("yyyy-MM-dd") ?? "日期未填写")@if (row.Group is not null) { <span> · @row.Group.Title</span> }@if (!string.IsNullOrWhiteSpace(row.Transaction?.Notes ?? row.Expense?.Notes)) { <span> · @(row.Transaction?.Notes ?? row.Expense?.Notes)</span> }</div>
        @if (!row.IsActive) { <div class="small text-secondary">撤销原因：@(row.Transaction?.ReversalReason ?? row.Expense?.ReversalReason)</div> }
        @if (row.IsActive || row.Transaction?.Allocations.Count > 1 || !string.IsNullOrWhiteSpace(row.Transaction?.ExternalReference))
        {
        <details class="ledger-more" open="@(hasError && (Request.Query["transactionId"].ToString() == row.Id.ToString() || Request.Query["expenseId"].ToString() == row.Id.ToString()))"><summary>更多</summary><div class="mt-2">
        @if (row.Transaction is { } transaction)
        {
            var sharedTransaction = transaction.Allocations.Count > 1;
            @if (!string.IsNullOrWhiteSpace(transaction.ExternalReference)) { <p class="small">参考号：@transaction.ExternalReference</p> }
            @if (sharedTransaction) { <p class="small">本单份额 @Money(row.AmountCents)，整笔交易 @Money(transaction.AmountCents)。撤销会影响全部 @transaction.Allocations.Count 个订单。</p><ul class="small">@foreach (var allocation in transaction.Allocations) { <li>@allocation.BusinessOrderNo · @allocation.ProjectName @(allocation.IsDeleted ? "（回收站）" : "") · @Money(allocation.AmountCents)</li> }</ul> }
            @if (row.IsActive)
            {
                @if (transaction.DateKnowledge != DateKnowledge.Known)
                {
                    <form method="post" asp-page-handler="SupplementTransaction" asp-route-id="@f.WorkItemId" asp-route-transactionId="@transaction.Id" class="inline-edit mb-3"><input type="hidden" name="SupplementInput.ExpectedVersion" value="@transaction.Version"/><input type="hidden" name="SupplementInput.DateKnowledge" value="Known"/><input type="hidden" name="SupplementInput.PaymentMethod" value="@transaction.PaymentMethod"/><input type="hidden" name="SupplementInput.ExternalReference" value="@transaction.ExternalReference"/><input type="hidden" name="SupplementInput.Notes" value="@transaction.Notes"/><label for="date-@transaction.Id" class="form-label">补充实际日期</label><input id="date-@transaction.Id" name="SupplementInput.TransactionDate" type="date" max="@Model.BusinessToday.ToString("yyyy-MM-dd")" class="form-control" required/><button class="btn btn-sm btn-outline-primary" type="submit">保存日期</button></form>
                }
                <form method="post" asp-page-handler="ReverseTransaction" asp-route-id="@f.WorkItemId" asp-route-transactionId="@transaction.Id"><label for="reason-@transaction.Id" class="form-label">撤销原因</label><input id="reason-@transaction.Id" name="ReverseInput.Reason" class="form-control" maxlength="500" required/><label class="form-check mt-2"><input class="form-check-input" type="checkbox" name="ReverseInput.Confirm" value="true" required/><span class="form-check-label">确认撤销整笔 @Money(transaction.AmountCents)，影响 @transaction.Allocations.Count 个订单</span></label><button class="btn btn-sm btn-outline-danger mt-2" type="submit">撤销交易</button></form>
            }
        }
        @if (row.Expense is { } expense && row.Group is { } group && row.IsActive)
        {
            <a class="btn btn-sm btn-outline-secondary mb-3" asp-page="/Finance/WorkItem" asp-route-id="@f.WorkItemId" asp-route-groupId="@group.Id" asp-fragment="expense-form">编辑支出详情</a>
            <form method="post" asp-page-handler="ReverseExpense" asp-route-id="@f.WorkItemId" asp-route-expenseId="@expense.Id"><input type="hidden" name="ReverseExpenseInput.ExpectedWorkItemVersion" value="@w.Version"/><label for="ledger-reason-@expense.Id" class="form-label">撤销原因</label><input id="ledger-reason-@expense.Id" name="ReverseExpenseInput.Reason" class="form-control" required/><button class="btn btn-sm btn-outline-danger mt-2" type="submit">撤销支出</button></form>
        }
        </div></details>
        }
    </article>
}
</div></section>
        <details class="surface mb-3 filter-panel" open="@(Model.GroupInput.ExpenseGroupId.HasValue || (hasError && handler is "SaveExpenseGroup" or "SetCostConfirmation" or "SetExpensePayment"))"><summary>分项支出、未付款与成本确认（进阶）</summary><div class="surface-header"><h2 class="h5 mb-0">成本事项</h2></div><div class="surface-body">
            <p class="small text-secondary">每个事项可拆成多个已发生分项；发生日期与支付日期分别记录。40 元已付 + 60 元未付会计为总成本 100 元、现金支出 40 元。</p>
            <form method="post" asp-page-handler="SaveExpenseGroup" id="expense-form">
                <input type="hidden" name="id" value="@f.WorkItemId" /><input asp-for="GroupInput.ExpectedWorkItemVersion" type="hidden" />
                <input asp-for="GroupInput.ExpenseGroupId" type="hidden" />
                @if (Model.GroupInput.ExpenseGroupId.HasValue) { <div class="alert alert-info">正在编辑已有成本事项。空日期需选择“历史未知”并留空日期字段。</div> }
                <div class="row g-2"><div class="col-sm-7"><label asp-for="GroupInput.Title" class="form-label">事项名称</label><input asp-for="GroupInput.Title" class="form-control" required /></div><div class="col-sm-5"><label asp-for="GroupInput.Category" class="form-label">成本分类</label><input asp-for="GroupInput.Category" class="form-control" required /></div><div class="col-12"><label asp-for="GroupInput.Notes" class="form-label">事项说明</label><input asp-for="GroupInput.Notes" class="form-control" /></div></div>
                <div class="expense-lines mt-3" id="expense-lines">
                @for (var i = 0; i < Model.GroupInput.Expenses.Count; i++)
                {
                    <div class="expense-line expense-edit-row">
                        <input asp-for="GroupInput.Expenses[i].Id" type="hidden" />
                        <div class="row g-2"><div class="col-sm-3"><label asp-for="GroupInput.Expenses[i].AmountYuan" class="form-label">金额（元）</label><input asp-for="GroupInput.Expenses[i].AmountYuan" type="number" min="0.01" step="0.01" class="form-control" required /></div><div class="col-sm-3"><label asp-for="GroupInput.Expenses[i].ExpenseDate" class="form-label">发生日期</label><input asp-for="GroupInput.Expenses[i].ExpenseDate" type="date" max="@Model.BusinessToday.ToString("yyyy-MM-dd")" class="form-control expense-date" /></div><div class="col-sm-3">@if (Model.GroupInput.Expenses[i].ExpenseDateIsHistoricalUnknown) { <label class="form-check mt-4"><input asp-for="GroupInput.Expenses[i].ExpenseDateIsHistoricalUnknown" class="form-check-input history-date-unknown" /><span class="form-check-label">历史发生日期仍无法确认</span></label> }</div><div class="col-sm-3"><label asp-for="GroupInput.Expenses[i].PaymentStatus" class="form-label">支付状态</label><select asp-for="GroupInput.Expenses[i].PaymentStatus" class="form-select"><option value="Unpaid">未支付</option><option value="Paid">已支付</option></select></div><div class="col-sm-4"><label asp-for="GroupInput.Expenses[i].PaidDate" class="form-label">支付日期</label><input asp-for="GroupInput.Expenses[i].PaidDate" type="date" max="@Model.BusinessToday.ToString("yyyy-MM-dd")" class="form-control paid-date" /></div><div class="col-sm-4">@if (Model.GroupInput.Expenses[i].PaidDateIsHistoricalUnknown) { <label class="form-check mt-4"><input asp-for="GroupInput.Expenses[i].PaidDateIsHistoricalUnknown" class="form-check-input history-date-unknown" /><span class="form-check-label">历史支付日期仍无法确认</span></label> }</div><div class="col-sm-4"><label asp-for="GroupInput.Expenses[i].Notes" class="form-label">分项备注</label><input asp-for="GroupInput.Expenses[i].Notes" class="form-control" /></div></div>
                    </div>
                }
                </div>
                <template id="expense-template"><div class="expense-line expense-edit-row"><input type="hidden" name="GroupInput.Expenses[__i__].Id" value="" /><div class="row g-2"><div class="col-sm-3"><label class="form-label" for="GroupInput_Expenses___i___AmountYuan">金额（元）</label><input id="GroupInput_Expenses___i___AmountYuan" name="GroupInput.Expenses[__i__].AmountYuan" type="number" min="0.01" step="0.01" class="form-control" required /></div><div class="col-sm-3"><label class="form-label" for="GroupInput_Expenses___i___ExpenseDate">发生日期</label><input id="GroupInput_Expenses___i___ExpenseDate" name="GroupInput.Expenses[__i__].ExpenseDate" type="date" value="@Model.BusinessToday.ToString("yyyy-MM-dd")" max="@Model.BusinessToday.ToString("yyyy-MM-dd")" class="form-control expense-date" /></div><div class="col-sm-3"></div><div class="col-sm-3"><label class="form-label" for="GroupInput_Expenses___i___PaymentStatus">支付状态</label><select id="GroupInput_Expenses___i___PaymentStatus" name="GroupInput.Expenses[__i__].PaymentStatus" class="form-select"><option value="Unpaid">未支付</option><option value="Paid">已支付</option></select></div><div class="col-sm-4"><label class="form-label" for="GroupInput_Expenses___i___PaidDate">支付日期</label><input id="GroupInput_Expenses___i___PaidDate" name="GroupInput.Expenses[__i__].PaidDate" type="date" max="@Model.BusinessToday.ToString("yyyy-MM-dd")" class="form-control paid-date" /></div><div class="col-sm-4"></div><div class="col-sm-4"><label class="form-label" for="GroupInput_Expenses___i___Notes">分项备注</label><input id="GroupInput_Expenses___i___Notes" name="GroupInput.Expenses[__i__].Notes" class="form-control" /></div></div></div></template>
                <button class="btn btn-sm btn-outline-secondary mt-2" type="button" id="add-expense-line">＋ 添加成本分项</button>
                <div class="form-check mt-3"><input asp-for="GroupInput.ConfirmComplete" class="form-check-input" /><label asp-for="GroupInput.ConfirmComplete" class="form-check-label">保存后确认本工作项成本完整</label></div>
                <button class="btn btn-primary mt-3" type="submit">保存成本事项</button>
            </form>
            <form method="post" asp-page-handler="SetCostConfirmation" class="inline-actions mt-3"><input type="hidden" name="id" value="@f.WorkItemId" /><input type="hidden" name="ConfirmStatus" value="ConfirmedNoCost" /><input type="hidden" name="ExpectedVersion" value="@w.Version" /><button class="btn btn-outline-secondary" type="submit">明确确认无成本</button></form>
            <div class="mt-3"><strong>当前确认状态：</strong>@CostLabel(f.CostConfirmationStatus)</div>
            @foreach (var group in f.ExpenseGroups)
            {
                <article class="expense-line mt-3"><h3 class="h6">@group.Title <span class="text-secondary">· @group.Category</span></h3><div class="small text-secondary">事项合计 @Money(group.TotalAmountCents) @if (group.Expenses.Any(x => x.Status == ExpenseStatus.Active)) { <span>· <a asp-page="/Finance/WorkItem" asp-route-id="@f.WorkItemId" asp-route-groupId="@group.Id">编辑事项</a></span> }</div>
                    @foreach (var expense in group.Expenses)
                    {
                        <div class="expense-item-row"><span>@Money(expense.AmountCents) · 发生 @DateLabel(expense.ExpenseDate, expense.ExpenseDateKnowledge) · @(expense.PaymentStatus == ExpensePaymentStatus.Paid ? "已付" : "未付") @if (expense.PaymentStatus == ExpensePaymentStatus.Paid) { <span>· 支付 @DateLabel(expense.PaidDate, expense.PaidDateKnowledge)</span> }</span><span class="small">@(expense.Status == ExpenseStatus.Active ? "有效" : "已撤销")</span></div>
                        @if (expense.Status == ExpenseStatus.Active)
                        {
                            <form method="post" asp-page-handler="SetExpensePayment" asp-route-id="@f.WorkItemId" asp-route-expenseId="@expense.Id" class="inline-edit mt-2"><input type="hidden" name="ExpensePaymentInput.ExpectedWorkItemVersion" value="@w.Version" /><label class="form-label" for="pay-state-@expense.Id">更新支付状态</label><select id="pay-state-@expense.Id" name="ExpensePaymentInput.PaymentStatus" class="form-select"><option value="Unpaid" selected="@(expense.PaymentStatus == ExpensePaymentStatus.Unpaid)">未支付</option><option value="Paid" selected="@(expense.PaymentStatus == ExpensePaymentStatus.Paid)">已支付</option></select><label class="form-label" for="pay-date-@expense.Id">实际支付日期</label><input id="pay-date-@expense.Id" name="ExpensePaymentInput.PaidDate" value="@expense.PaidDate?.ToString("yyyy-MM-dd")" type="date" max="@Model.BusinessToday.ToString("yyyy-MM-dd")" class="form-control" />@if (expense.PaidDateKnowledge == DateKnowledge.Unknown) { <label class="form-check"><input class="form-check-input" type="checkbox" name="ExpensePaymentInput.PaidDateIsHistoricalUnknown" value="true" checked="checked" /><span class="form-check-label">历史支付日期仍无法确认</span></label> }<label class="form-check"><input class="form-check-input" type="checkbox" name="ExpensePaymentInput.IsCorrection" value="true" /><span class="form-check-label">纠正已录支付资料</span></label><label class="form-label" for="pay-correction-@expense.Id">纠正原因</label><input id="pay-correction-@expense.Id" name="ExpensePaymentInput.CorrectionReason" class="form-control" /><button class="btn btn-sm btn-outline-primary" type="submit">保存支付状态</button></form>
                            <form method="post" asp-page-handler="ReverseExpense" asp-route-id="@f.WorkItemId" asp-route-expenseId="@expense.Id" class="inline-edit mt-2"><input type="hidden" name="ReverseExpenseInput.ExpectedWorkItemVersion" value="@w.Version" /><label class="form-label" for="expense-reason-@expense.Id">撤销原因</label><input id="expense-reason-@expense.Id" name="ReverseExpenseInput.Reason" class="form-control" required /><button class="btn btn-sm btn-outline-danger" type="submit">撤销分项</button></form>
                        }
                    }
                </article>
            }
        </div></details>
@section Scripts {
<script src="~/js/finance-editor.js" asp-append-version="true"></script>
<script>
(() => {
  const add = document.getElementById('add-expense-line');
  const list = document.getElementById('expense-lines');
  const template = document.getElementById('expense-template');
  if (!add || !list || !template) return;
  add.addEventListener('click', () => {
    const index = list.querySelectorAll('.expense-edit-row').length;
    list.insertAdjacentHTML('beforeend', template.innerHTML.replaceAll('__i__', String(index)));
  });
  document.addEventListener('change', event => {
    const checkbox = event.target.closest('.history-date-unknown');
    if (!checkbox || !checkbox.checked) return;
    const row = checkbox.closest('.expense-edit-row');
    const target = checkbox.name.includes('ExpenseDateIsHistoricalUnknown') ? row?.querySelector('.expense-date') : row?.querySelector('.paid-date');
    if (target) target.value = '';
  });
  document.querySelectorAll('input[name="ExpensePaymentInput.PaidDateIsHistoricalUnknown"]').forEach(checkbox => checkbox.addEventListener('change', () => {
    if (checkbox.checked) { const date = checkbox.form?.querySelector('[name="ExpensePaymentInput.PaidDate"]'); if (date) date.value = ''; }
  }));
})();
</script>
}
