@page
@model PersonalOrderDesk.Pages.Finance.IndexModel
@using PersonalOrderDesk.Domain
@using PersonalOrderDesk.Services
@using PersonalOrderDesk.Presentation
@{
    ViewData["Title"] = "收支结算";
    var o = Model.Overview;
    string Money(long? cents) => cents is null ? "待补资料" : $"¥{cents.Value / 100m:N2}";
}
<div class="page-heading"><div><h1>收支结算</h1><p>订单经营按接单日期分组；实际收支按实际收款、退款和支付日期统计。</p></div><div class="inline-actions">@if (o is not null) { <button class="btn btn-outline-primary" type="button" id="copy-unsettled">复制未结款清单</button> }<a class="btn btn-primary" asp-page="/Finance/Transactions/Create">＋ 记录收款 / 退款</a></div></div>
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div> }
@if (o is not null)
{
    var copyList = UnsettledCopyList.From(o.WorkItems);
    <div class="small mb-3" id="copy-unsettled-status" role="status" aria-live="polite"></div>
    <details class="surface detail-fold mb-3" id="unsettled-preview"><summary>未结款复制预览 · @copyList.LineCount 个编号 · ¥@((copyList.TotalCents / 100m).ToString("N2"))</summary><div class="surface-body"><p class="small text-secondary">当前筛选范围的剩余待收金额；同编号追加单合并，每行“编号 金额”。</p><textarea id="unsettled-text" aria-label="未结款清单" class="form-control" rows="5" readonly data-count="@copyList.LineCount">@copyList.Text</textarea>@if (copyList.MissingNumberCount > 0 || copyList.MissingAmountCount > 0) { <p class="text-danger small mt-2 mb-0">另有 @copyList.MissingNumberCount 个待收项目缺编号、@copyList.MissingAmountCount 个项目金额待补，未加入清单，请核对。</p> }</div></details>
    <div class="finance-metrics mb-3" aria-label="收支与利润">
        <div class="finance-metric received-money"><span>已记收款</span><strong>@Money(o.WorkItems.Sum(x => x.NetReceivedCents))</strong></div>
        <div class="finance-metric"><span>已记支出</span><strong>@Money(o.WorkItems.Sum(x => x.TotalCostCents))</strong></div>
        <div class="finance-metric profit-metric"><span>已记利润</span><strong>@Money(o.WorkItems.Sum(x => x.NetReceivedCents - x.TotalCostCents))</strong><small>已登记收款 − 已登记支出</small></div>
        <div class="finance-metric pending-money"><span>待收余额</span><strong>@Money(o.TotalOutstandingCents)</strong></div>
    </div>
    <p class="small text-secondary">按下方订单范围汇总，不要求补日期或额外确认成本。未登记的收支不会计入利润，回收站项目不计入本页统计。</p>
    <details class="surface mb-3 filter-panel"><summary>调整统计范围 <span>接单日期、收支日期、项目类型</span></summary><form method="get"><div class="surface-body">
        <div class="row g-3">
            <div class="col-md-3"><label asp-for="ReceivedYear" class="form-label">订单经营接单年份</label><input asp-for="ReceivedYear" type="number" min="2000" max="2200" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="ReceivedMonth" class="form-label">订单经营接单月份</label><select asp-for="ReceivedMonth" class="form-select"><option value="">全年</option>@for (var m = 1; m <= 12; m++) { <option value="@m">@m 月</option> }</select></div>
            <div class="col-md-3"><label asp-for="CashYear" class="form-label">实际收支年份</label><input asp-for="CashYear" type="number" min="2000" max="2200" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="CashMonth" class="form-label">实际收支月份</label><select asp-for="CashMonth" class="form-select"><option value="">全年</option>@for (var m = 1; m <= 12; m++) { <option value="@m">@m 月</option> }</select></div>
            <div class="col-md-4"><label asp-for="ProjectType" class="form-label">项目类型</label><select asp-for="ProjectType" class="form-select"><option value="">全部类型</option><option value="Simulation">仿真</option><option value="SchematicPcbDesign">原理图 / PCB 设计</option><option value="CodeReport">代码 / 报告</option><option value="PhysicalProduction">实物制作</option><option value="Other">其他</option><option value="MixedOrUnknown">综合 / 未知</option></select></div>
            <div class="col-md-4"><label asp-for="WorkStatus" class="form-label">当前工作状态</label><select asp-for="WorkStatus" class="form-select"><option value="">全部状态</option><option value="NotStarted">未开始</option><option value="InProgress">进行中</option><option value="Completed">已完成</option><option value="NeedsRework">需返工</option><option value="Cancelled">已取消</option></select><div class="form-text">状态筛选使用当前状态，不代表历史时点。</div></div>
        </div>
        <div class="inline-actions mt-3"><button class="btn btn-primary" type="submit">应用查询</button><a class="btn btn-outline-secondary" asp-page="/Finance/Index">恢复默认查询</a></div>
    </div></form></details>
    <section class="surface mb-3"><div class="surface-header"><h2 class="h5 mb-0">按编号记收支</h2></div><div class="surface-body">
        @{ var dueItems = o.WorkItems.ToArray(); }
        @if (dueItems.Length == 0) { <p class="text-secondary mb-0">当前筛选下没有订单。</p> }
        else { <div class="table-responsive"><table class="table table-hover record-cards"><thead><tr><th>订单编号</th><th>项目名称</th><th>收款</th><th>支出</th><th>利润</th><th>待收</th><th>操作</th></tr></thead><tbody>@foreach (var w in dueItems) { <tr><td data-label="订单编号" class="order-number">@(w.BusinessOrderNo ?? "未编号")</td><td data-label="项目名称"><a asp-page="/Finance/WorkItem" asp-route-id="@w.WorkItemId">@w.ProjectName</a></td><td data-label="收款" class="text-success">@Money(w.NetReceivedCents)</td><td data-label="支出">@Money(w.TotalCostCents)</td><td data-label="利润" class="fw-semibold @(w.NetReceivedCents >= w.TotalCostCents ? "text-success" : "text-danger")">@Money(w.NetReceivedCents - w.TotalCostCents)</td><td data-label="待收" class="@(w.OutstandingCents > 0 ? "text-danger" : "text-secondary")">@Money(w.OutstandingCents)</td><td data-label="操作"><a class="btn btn-sm btn-outline-primary" asp-page="/Finance/WorkItem" asp-route-id="@w.WorkItemId">记收支</a></td></tr> }</tbody></table></div> }
    </div></section>
<details class="surface filter-panel"><summary>月份、类型与详细统计（可选）</summary><div class="surface-body">    <div class="row g-3 mb-3">
        <div class="col-md-6"><section class="surface h-100"><div class="surface-header"><h2 class="h5 mb-0">实际收支 · 按交易 / 支付日期</h2></div><div class="surface-body"><dl class="detail-grid"><div class="detail-item"><dt>所选期间净收款</dt><dd>@Money(o.TotalNetReceivedCents)</dd></div><div class="detail-item"><dt>所选期间已付成本</dt><dd>@Money(o.TotalPaidCostCents)</dd></div><div class="detail-item"><dt>所选期间现金净额</dt><dd>@Money(o.ActualCashNetCents)</dd></div><div class="detail-item"><dt>历史日期未知收款</dt><dd>@Money(o.UnknownDateNetReceivedCents)</dd></div><div class="detail-item"><dt>历史支付日期未知成本</dt><dd>@Money(o.UnknownDatePaidCostCents)</dd></div></dl><p class="small text-secondary mb-0">未知日期金额单独展示，不归入所选年份或月份。</p></div></section></div>
        <div class="col-md-6"><section class="surface h-100"><div class="surface-header"><h2 class="h5 mb-0">订单经营 · 按接单日期，截至当前</h2></div><div class="surface-body"><p>接单日期未知项目：<strong>@o.UnknownReceivedDateWorkItemCount 项</strong></p><p class="small text-secondary mb-0">10 月接单、11 月收款的订单仍归入 10 月经营；实际现金按交易日期归入 11 月。</p></div></section></div>
    </div>
    <div class="row g-3">
        <div class="col-lg-6"><section class="surface"><div class="surface-header"><h2 class="h5 mb-0">按项目类型汇总</h2><div class="small text-secondary">净收款、已付成本与现金净额按现金期间；毛利按经营接单筛选口径。</div></div><div class="surface-body">@if (o.Categories.Count == 0) { <p class="text-secondary mb-0">当前筛选没有项目类型汇总。</p> } else { <div class="table-responsive"><table class="table"><thead><tr><th>项目类型</th><th>净收款</th><th>已付成本</th><th>已核算毛利</th><th>现金净额</th></tr></thead><tbody>@foreach (var row in o.Categories) { <tr><td>@row.Category</td><td>@Money(row.NetReceivedCents)</td><td>@Money(row.PaidCostCents)</td><td>@Money(row.ExpectedGrossProfitCents)</td><td>@Money(row.ActualCashNetCents)</td></tr> }</tbody></table></div> }</div></section></div>
        <div class="col-lg-6"><section class="surface"><div class="surface-header"><h2 class="h5 mb-0">全部月份（按项目类型与当前状态筛选）</h2><div class="small text-secondary">所有历史现金月份，不受上方现金期间或接单期间限制；月份仍按实际交易 / 支付日期归属。</div></div><div class="surface-body">@if (o.Months.Count == 0) { <p class="text-secondary mb-0">当前项目类型与状态筛选下没有已知日期的月份。</p> } else { <div class="table-responsive"><table class="table"><thead><tr><th>月份</th><th>净收款</th><th>已付成本</th><th>现金净额</th></tr></thead><tbody>@foreach (var row in o.Months.OrderByDescending(x => x.Year).ThenByDescending(x => x.Month)) { <tr><td>@row.Year-@row.Month.ToString("00")</td><td>@Money(row.NetReceivedCents)</td><td>@Money(row.PaidCostCents)</td><td>@Money(row.ActualCashNetCents)</td></tr> }</tbody></table></div> }</div></section></div>
    </div></div></details>
}

@section Scripts { <script src="~/js/unsettled-copy.js" asp-append-version="true"></script> }
