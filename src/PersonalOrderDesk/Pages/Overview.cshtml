@page
@model PersonalOrderDesk.Pages.OverviewModel
@{ ViewData["Title"] = "概览"; string Money(long value) => $"¥{value / 100m:N2}"; }
<div class="page-heading"><div><h1>概览</h1><p>所有订单与已登记收支，一眼查看。</p></div><div class="inline-actions"><a class="btn btn-primary" asp-page="/WorkItems/Create">＋ 新增订单</a><a class="btn btn-outline-secondary" asp-page="/Index">查看今日待办</a></div></div>
<section aria-labelledby="order-summary"><h2 class="h5 mb-3" id="order-summary">接单情况</h2><div class="finance-metrics mb-4">
<a class="finance-metric overview-link" asp-page="/WorkItems/Index"><span>总单量</span><strong>@Model.Orders.Count <small>单</small></strong></a>
<a class="finance-metric overview-link" asp-page="/WorkItems/Index" asp-route-status="Completed"><span>已完成</span><strong class="text-success">@Model.Completed <small>单</small></strong></a>
<a class="finance-metric overview-link" asp-page="/WorkItems/Index" asp-route-filter="InProgress"><span>进行中</span><strong>@Model.Working <small>单</small></strong></a>
<a class="finance-metric overview-link" asp-page="/WorkItems/Index" asp-route-status="NotStarted"><span>未开始</span><strong>@Model.NotStarted <small>单</small></strong></a>
</div></section>
<section aria-labelledby="money-summary"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h5 mb-0" id="money-summary">收入与利润</h2><a asp-page="/Finance/Index">按编号记收支 →</a></div><div class="overview-money mb-3">
<div class="finance-metric"><span>报价合计</span><strong>@Money(Model.Money.Sum(x => x.OrderAmountCents ?? 0))</strong></div>
<div class="finance-metric received-money"><span>已收款</span><strong>@Money(Model.Received)</strong></div>
<div class="finance-metric"><span>已记支出</span><strong>@Money(Model.Expense)</strong></div>
<div class="finance-metric profit-metric"><span>已记利润</span><strong class="@(Model.Profit >= 0 ? "text-success" : "text-danger")">@Money(Model.Profit)</strong><small>收款 − 支出</small></div>
<div class="finance-metric pending-money"><span>待收金额</span><strong>@Money(Model.Money.Sum(x => x.OutstandingCents ?? 0))</strong></div>
<div class="finance-metric"><span>已收齐订单</span><strong>@Model.Money.Count(x => x.OrderAmountCents.HasValue && x.OutstandingCents == 0) <small>单</small></strong></div>
</div><p class="small text-secondary mb-4">统计未删除的订单，包含已归档，不含回收站；利润按已登记收款减全部已记支出。日期留空也计入总额，未补的收支不会自动估算。</p></section>
<section class="surface"><div class="surface-header"><h2 class="h5 mb-0">最近接单</h2></div><div class="surface-body">
@if (Model.Orders.Count == 0) { <p class="text-secondary">还没有订单，从“新增订单”开始记录。</p> }
@foreach (var order in Model.Orders.OrderByDescending(x => x.ReceivedDate).Take(6))
{ <a class="compact-queue-row" asp-page="/WorkItems/Details" asp-route-id="@order.Id"><span class="compact-queue-name"><span class="order-number">@(order.BusinessOrderNo ?? "未编号")</span> · @order.ProjectName</span><span class="compact-queue-value">@order.ReceivedDate?.ToString("MM-dd")</span></a> }
</div></section>
