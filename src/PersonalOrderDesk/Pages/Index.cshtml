@page
@model IndexModel
@using PersonalOrderDesk.Services
@using PersonalOrderDesk.Domain
@{
    ViewData["Title"] = "今日工作台";
    var sections = Model.Dashboard?.Sections ?? Array.Empty<WorkSectionDto>();
    WorkSectionDto? Section(WorkSectionKind kind) => sections.FirstOrDefault(x => x.Kind == kind);
    string WorkLabel(WorkStatus status) => status switch { WorkStatus.NotStarted => "未开始", WorkStatus.InProgress => "进行中", WorkStatus.Completed => "已完成", WorkStatus.NeedsRework => "需返工", _ => "已取消" };
    string ProjectTypeLabel(ProjectType type) => type switch { ProjectType.Simulation => "仿真", ProjectType.SchematicPcbDesign => "原理图 / PCB 设计", ProjectType.CodeReport => "代码 / 报告", ProjectType.PhysicalProduction => "实物制作", ProjectType.MixedOrUnknown => "综合 / 未知", _ => "其他" };
    string PaymentLabel(string state) => state switch { "AmountPending" => "待补金额", "NoPaymentRequired" => "无需收款", "Unpaid" => "未收款", "PartiallyPaid" => "部分收款", "Paid" => "已收齐", "Overpaid" => "超收待核对", _ => state };
    string FulfillmentLabel(string state) => state switch { "None" => "无需快递", "NotReady" => "未到发货阶段", "PendingShipment" => "待寄出", "Paused" => "已暂停", "Shipped" => "已寄出", "Delivered" => "已签收", "HistoryReview" => "历史物流待核对", _ => state };
    string Money(long? cents) => cents is null ? "待补金额" : $"¥{cents.Value / 100m:N2}";
    string SectionHeading(WorkSectionKind kind) => kind switch { WorkSectionKind.Overdue => "已逾期", WorkSectionKind.DueToday => "今日到期", WorkSectionKind.Upcoming => "即将到期", WorkSectionKind.InProgress => "进行中", WorkSectionKind.NeedsInformation => "待补信息", WorkSectionKind.ReadyToShip => "待寄出", WorkSectionKind.AwaitingPayment => "待收款", WorkSectionKind.HistoricalCompletionReview => "历史资料完善", _ => "历史物流核对" };
    string DateHint(WorkItemRowDto row) => row.Status switch { WorkStatus.Completed => "已完成", WorkStatus.Cancelled => "已取消", _ => row.Urgency switch { WorkUrgency.Overdue => $"逾期 {Math.Abs(row.DaysUntilDue ?? 0)} 天", WorkUrgency.DueToday => "今日到期", WorkUrgency.PhysicalUpcoming or WorkUrgency.DigitalUpcoming => $"距截止 {row.DaysUntilDue} 天", WorkUrgency.NoDueDate => "待补时限", _ => row.EffectiveDueDate?.ToString("yyyy-MM-dd") ?? "未设期限" } };
}
<div class="page-heading">
    <div><h1>今日工作台</h1><p>业务日期：@Model.Dashboard?.BusinessDate.ToString("yyyy-MM-dd") · 工作、收款与物流分别跟进</p></div>
    <div class="inline-actions"><a class="btn btn-primary" asp-page="/WorkItems/Create">＋ 快速新增</a><a class="btn btn-outline-primary" asp-page="/WorkItems/Index">查看全部工作项</a></div>
</div>
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div> }
<div class="metric-grid mb-4" aria-label="优先处理事项">
@foreach (var (kind, cls) in new[] { (WorkSectionKind.Overdue, "overdue"), (WorkSectionKind.DueToday, "due-today"), (WorkSectionKind.AwaitingPayment, "payment-due") })
{
    var section = Section(kind);
    <a class="metric-card @cls" asp-page="/WorkItems/Index" asp-route-filter="@kind"><span>@SectionHeading(kind)</span><strong>@(section?.Count ?? 0)</strong></a>
}
</div>
@if (!new[] { WorkSectionKind.Overdue, WorkSectionKind.DueToday, WorkSectionKind.Upcoming, WorkSectionKind.InProgress }.Any(k => Section(k)?.Count > 0))
{
    <section class="surface work-clear mb-3"><div><span class="status-badge status-work completed">制作待办已清</span><h2 class="h5 mt-2">当前没有制作中的紧急待办</h2><p class="text-secondary mb-0">已完成项目可以继续核对收款、物流和历史资料。所有订单都在工作项列表里。</p></div><a class="btn btn-outline-primary" asp-page="/WorkItems/Index">查看订单进度 →</a></section>
}
@foreach (var kind in new[] { WorkSectionKind.Overdue, WorkSectionKind.DueToday, WorkSectionKind.Upcoming, WorkSectionKind.InProgress })
{
    var currentSection = Section(kind);
    if (currentSection is { Count: > 0 })
    {
        <section class="surface mb-3" aria-labelledby="heading-@kind">
            <div class="surface-header d-flex justify-content-between align-items-center"><h2 class="h5 mb-0" id="heading-@kind">@SectionHeading(kind)</h2><span class="text-secondary">@currentSection.Count 项</span></div>
            <div class="surface-body work-list">
            @foreach (var row in currentSection.Items)
            {
                var cardClass = row.Urgency == WorkUrgency.Overdue ? "overdue" : row.Urgency == WorkUrgency.DueToday ? "due-today" : row.Urgency is WorkUrgency.PhysicalUpcoming or WorkUrgency.DigitalUpcoming ? "upcoming" : row.Status == WorkStatus.Completed ? "completed" : row.Status == WorkStatus.Cancelled ? "cancelled" : row.Status == WorkStatus.InProgress ? "in-progress" : "";
                <article class="work-card @cardClass">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                        <div><h3 class="work-title"><a asp-page="/WorkItems/Details" asp-route-id="@row.Id">@row.ProjectName</a></h3><div class="work-meta"><span>@(row.BusinessOrderNo ?? "未填写编号")</span><span>@ProjectTypeLabel(row.ProjectType)</span><span>@(row.EffectiveDueDate?.ToString("yyyy-MM-dd") ?? "无截止日期")</span><span class="due-label @(row.Urgency == WorkUrgency.Overdue ? "danger" : row.Urgency == WorkUrgency.DueToday ? "today" : row.Urgency is WorkUrgency.PhysicalUpcoming or WorkUrgency.DigitalUpcoming ? "upcoming" : "")">@DateHint(row)</span></div></div>
                        <div class="inline-actions"><span class="status-badge status-work @(row.Status == WorkStatus.Completed ? "completed" : row.Status == WorkStatus.Cancelled ? "cancelled" : row.Status == WorkStatus.InProgress ? "in-progress" : "")">@WorkLabel(row.Status)</span><span class="status-badge status-payment">@PaymentLabel(row.PaymentState)</span><span class="status-badge status-shipping">@FulfillmentLabel(row.FulfillmentState)</span></div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(row.CurrentWork) || !string.IsNullOrWhiteSpace(row.NextStep)) { <p class="work-summary">@if (!string.IsNullOrWhiteSpace(row.CurrentWork)) { <span>当前：@row.CurrentWork</span> }@if (!string.IsNullOrWhiteSpace(row.NextStep)) { <span>　下一步：@row.NextStep</span> }</p> }
                </article>
            }
            </div>
        </section>
    }
}
@foreach (var kind in new[] { WorkSectionKind.AwaitingPayment, WorkSectionKind.ReadyToShip })
{
    var workSection = Section(kind);
    if (workSection is { Count: > 0 })
    {
        <section class="surface compact-queue mb-3" aria-labelledby="queue-@kind">
            <div class="surface-header"><h2 class="h6 mb-0" id="queue-@kind">@SectionHeading(kind) <span class="text-secondary">@workSection.Count 项</span></h2><a class="small" asp-page="/WorkItems/Index" asp-route-filter="@kind">查看全部</a></div>
            <div class="compact-queue-list">
            @foreach (var row in workSection.Items)
            {
                <a class="compact-queue-row" asp-page="/WorkItems/Details" asp-route-id="@row.Id"><span class="compact-queue-name">@row.ProjectName <small>@(row.BusinessOrderNo ?? "未填写编号")</small></span><span class="compact-queue-value">@(kind == WorkSectionKind.AwaitingPayment ? $"待收 {Money(row.OutstandingCents)}" : FulfillmentLabel(row.FulfillmentState))</span></a>
            }
            </div>
        </section>
    }
}
@{
    var reviewKinds = new[] { WorkSectionKind.NeedsInformation, WorkSectionKind.HistoricalCompletionReview, WorkSectionKind.HistoricalShipmentReview };
    var reviewCount = reviewKinds.Sum(k => Section(k)?.Count ?? 0);
}
@if (reviewCount > 0)
{
    <details class="surface review-fold mb-3">
        <summary><span>资料补全与历史核对</span><span class="text-secondary">@reviewCount 项</span></summary>
        <div class="compact-queue-list">
        @foreach (var kind in reviewKinds)
        {
            var workSection = Section(kind);
            if (workSection is { Count: > 0 })
            {
                <div class="review-group"><h3>@SectionHeading(kind) <span>@workSection.Count 项</span></h3>
                @foreach (var row in workSection.Items)
                {
                    <a class="compact-queue-row" asp-page="/WorkItems/Details" asp-route-id="@row.Id"><span class="compact-queue-name">@row.ProjectName <small>@(row.BusinessOrderNo ?? "未填写编号")</small></span><span class="compact-queue-value">查看记录 →</span></a>
                }
                </div>
            }
        }
        </div>
    </details>
}
