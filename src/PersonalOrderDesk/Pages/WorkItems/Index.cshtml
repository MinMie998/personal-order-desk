@page
@model PersonalOrderDesk.Pages.WorkItems.IndexModel
@using PersonalOrderDesk.Services
@using PersonalOrderDesk.Domain
@{
    ViewData["Title"] = "全部工作项";
    string WorkLabel(WorkStatus s) => s switch { WorkStatus.NotStarted => "未开始", WorkStatus.InProgress => "进行中", WorkStatus.NeedsRework => "需返工", WorkStatus.Completed => "已完成", _ => "已取消" };
    string ProjectTypeLabel(ProjectType type) => type switch { ProjectType.Simulation => "仿真", ProjectType.SchematicPcbDesign => "原理图 / PCB 设计", ProjectType.CodeReport => "代码 / 报告", ProjectType.PhysicalProduction => "实物制作", ProjectType.MixedOrUnknown => "综合 / 未知", _ => "其他" };
    string PaymentLabel(string s) => s switch { "AmountPending" => "待补金额", "NoPaymentRequired" => "无需收款", "Unpaid" => "未收款", "PartiallyPaid" => "部分收款", "Paid" => "已收齐", "Overpaid" => "超收待核对", _ => s };
    string FulfillmentLabel(string s) => s switch { "None" => "无需快递", "NotReady" => "未到发货阶段", "PendingShipment" => "待寄出", "Paused" => "已暂停", "Shipped" => "已寄出", "Delivered" => "已签收", "HistoryReview" => "历史物流待核对", _ => s };
    string DueLabel(WorkItemRowDto r) => r.Status switch { WorkStatus.Completed => "已完成", WorkStatus.Cancelled => "已取消", _ => r.Urgency switch { WorkUrgency.Overdue => $"逾期 {Math.Abs(r.DaysUntilDue ?? 0)} 天", WorkUrgency.DueToday => "今日到期", WorkUrgency.PhysicalUpcoming or WorkUrgency.DigitalUpcoming => $"距截止 {r.DaysUntilDue} 天", WorkUrgency.NoDueDate => "待补时限", _ => "" } };
    string Money(long? cents) => cents is null ? "待补金额" : $"¥{cents.Value / 100m:N2}";
}
<div class="page-heading"><div><h1>全部工作项</h1><p>共 @Model.TotalCount 项。工作进度、收款和物流状态分开显示。</p></div><div class="inline-actions"><a class="btn btn-outline-secondary" asp-page="/WorkItems/RecycleBin">回收站</a><a class="btn btn-primary" asp-page="/WorkItems/Create">＋ 快速新增</a></div></div>
@if (TempData["Notice"] is string notice) { <div class="alert alert-success" role="status">@notice</div> }
<form method="get" class="quick-search mb-3" role="search"><label for="quickSearch" class="visually-hidden">搜索编号或项目名称</label><input id="quickSearch" name="Search" value="@Model.Search" class="form-control" placeholder="输入订单编号、项目名称或关键词"/><input type="hidden" name="Status" value="@Model.Status"/><input type="hidden" name="ProjectType" value="@Model.ProjectType"/><input type="hidden" name="ScheduleCategory" value="@Model.ScheduleCategory"/><input type="hidden" name="IncludeArchived" value="@Model.IncludeArchived.ToString()"/><input type="hidden" name="ReceivedFrom" value="@Model.ReceivedFrom?.ToString("yyyy-MM-dd")"/><input type="hidden" name="ReceivedTo" value="@Model.ReceivedTo?.ToString("yyyy-MM-dd")"/><button class="btn btn-primary" type="submit">搜索</button>@if (!string.IsNullOrWhiteSpace(Model.Search)) { <a class="btn btn-outline-secondary" asp-page="/WorkItems/Index" asp-route-status="@Model.Status" asp-route-projectType="@Model.ProjectType" asp-route-scheduleCategory="@Model.ScheduleCategory" asp-route-includeArchived="@Model.IncludeArchived" asp-route-receivedFrom="@Model.ReceivedFrom?.ToString("yyyy-MM-dd")" asp-route-receivedTo="@Model.ReceivedTo?.ToString("yyyy-MM-dd")">清除</a> }</form>
<details class="surface mb-3 filter-panel"><summary>更多筛选 <span>状态、类型、日期、归档</span></summary><div class="surface-body">
    <form method="get" class="filter-bar" role="search">
        <input type="hidden" name="Search" value="@Model.Search"/>
        <div><label asp-for="Status" class="form-label">工作状态</label><select asp-for="Status" class="form-select"><option value="">全部</option><option value="NotStarted">未开始</option><option value="InProgress">进行中</option><option value="Completed">已完成</option><option value="NeedsRework">需返工</option><option value="Cancelled">已取消</option></select></div>
        <div><label asp-for="ProjectType" class="form-label">项目类型</label><select asp-for="ProjectType" class="form-select"><option value="">全部</option><option value="Simulation">仿真</option><option value="SchematicPcbDesign">原理图 / PCB 设计</option><option value="CodeReport">代码 / 报告</option><option value="PhysicalProduction">实物制作</option><option value="Other">其他</option><option value="MixedOrUnknown">综合 / 未知</option></select></div>
        <div><label asp-for="ScheduleCategory" class="form-label">工期分类</label><select asp-for="ScheduleCategory" class="form-select"><option value="">全部</option><option value="Physical">实物工期</option><option value="Digital">非实物工期</option><option value="Pending">待确认</option></select></div>
        <div><button class="btn btn-primary w-100" type="submit">搜索筛选</button></div>
        <div><label asp-for="ReceivedFrom" class="form-label">接单起始</label><input asp-for="ReceivedFrom" type="date" class="form-control" /></div>
        <div><label asp-for="ReceivedTo" class="form-label">接单截止</label><input asp-for="ReceivedTo" type="date" class="form-control" /></div>
        <div class="form-check"><input asp-for="IncludeArchived" class="form-check-input" /><label asp-for="IncludeArchived" class="form-check-label">包括已归档</label></div>
        <div><a class="btn btn-outline-secondary w-100" asp-page="/WorkItems/Index">清除筛选</a></div>
    </form>
</div></details>
@if (Model.Filter is not null) { <div class="alert alert-info">按首页“@(Model.Filter switch { WorkSectionKind.Overdue => "已逾期", WorkSectionKind.DueToday => "今日到期", WorkSectionKind.Upcoming => "即将到期", WorkSectionKind.InProgress => "进行中", WorkSectionKind.NeedsInformation => "待补信息", WorkSectionKind.ReadyToShip => "待寄出", WorkSectionKind.AwaitingPayment => "待收款", WorkSectionKind.HistoricalCompletionReview => "历史资料完善", _ => "历史物流核对" })”分区查看。若需组合搜索，请使用上方筛选。</div> }
@if (Model.Items.Count == 0)
{
    <div class="surface empty-state"><p>没有符合条件的工作项。</p><div class="inline-actions justify-content-center"><a class="btn btn-outline-primary" asp-page="/WorkItems/Index">清除筛选</a><a class="btn btn-outline-secondary" asp-page="/WorkItems/RecycleBin">查看回收站</a></div></div>
}
else
{
    <div class="surface table-responsive"><table class="table table-hover record-cards work-items-table">
        <thead><tr><th>工作项</th><th>工作状态 / 截止</th><th>当前进度 / 下一步</th><th>收款</th><th>物流</th><th>操作</th></tr></thead>
        <tbody>@foreach (var row in Model.Items)
        {
            <tr>
                <td data-label="工作项"><a class="project-name" asp-page="/WorkItems/Details" asp-route-id="@row.Id">@row.ProjectName</a><div class="project-meta"><span class="project-number">@(row.BusinessOrderNo ?? "未填写编号")</span><span>@ProjectTypeLabel(row.ProjectType)</span></div>@if (row.IsArchived) { <span class="status-badge status-work cancelled mt-1">已归档</span> }</td>
                <td data-label="工作进度"><span class="status-badge status-work @(row.Status == WorkStatus.Completed ? "completed" : row.Status == WorkStatus.Cancelled ? "cancelled" : row.Status == WorkStatus.InProgress ? "in-progress" : "")">@WorkLabel(row.Status)</span><div class="small mt-1">@(row.EffectiveDueDate?.ToString("yyyy-MM-dd") ?? "无截止日期")</div>@if (row.Status is not (WorkStatus.Completed or WorkStatus.Cancelled)) { <div class="small due-label @(row.Urgency == WorkUrgency.Overdue ? "danger" : row.Urgency == WorkUrgency.DueToday ? "today" : row.Urgency is WorkUrgency.PhysicalUpcoming or WorkUrgency.DigitalUpcoming ? "upcoming" : "")">@DueLabel(row)</div> }</td>
                <td data-label="当前与下一步">@if (!string.IsNullOrWhiteSpace(row.CurrentWork)) { <div>@row.CurrentWork</div> }@if (!string.IsNullOrWhiteSpace(row.NextStep) && row.Status != WorkStatus.Completed && row.Status != WorkStatus.Cancelled) { <div class="small text-secondary">下一步：@row.NextStep</div> } else if (row.Status == WorkStatus.Completed) { <div class="small text-secondary">@(row.OutstandingCents is null ? "待补金额" : row.PaymentState.Contains("超收") || row.PaymentState == "Overpaid" ? "超收待核对" : row.OutstandingCents > 0 ? "待核对收款" : "收款已结清")</div> } else if (row.Status == WorkStatus.Cancelled) { <span class="small text-secondary">订单已取消</span> } else if (string.IsNullOrWhiteSpace(row.CurrentWork)) { <a class="small" asp-page="/WorkItems/Edit" asp-route-id="@row.Id" asp-fragment="progress-fields">补充进度</a> }</td>
                <td data-label="收款记录"><span class="status-badge status-payment @(row.PaymentState is "Paid" or "已收齐" ? "paid" : row.PaymentState is "Unpaid" or "PartiallyPaid" or "未收款" or "部分收款" ? "unpaid" : "")">@PaymentLabel(row.PaymentState)</span><div class="small mt-1">净收 @Money(row.NetReceivedCents)</div>@if (row.OutstandingCents is not null) { <div class="small">待收 @Money(row.OutstandingCents)</div> }</td>
                <td data-label="物流"><span class="status-badge status-shipping @(row.FulfillmentState is "None" or "无需快递" ? "not-required" : "")">@FulfillmentLabel(row.FulfillmentState)</span></td>
                <td data-label="操作"><a class="btn btn-sm btn-outline-primary" asp-page="/WorkItems/Details" asp-route-id="@row.Id">打开</a></td>
            </tr>
        }</tbody>
    </table></div>
    @if (Model.TotalCount > Model.PageSize) { <nav class="d-flex justify-content-between align-items-center mt-3" aria-label="列表分页"><span>第 @Model.PageNumber 页</span><div class="inline-actions">@if (Model.PageNumber > 1) { <a class="btn btn-outline-secondary" asp-route-page="@(Model.PageNumber - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-projectType="@Model.ProjectType" asp-route-scheduleCategory="@Model.ScheduleCategory" asp-route-includeArchived="@Model.IncludeArchived">上一页</a> }@if (Model.PageNumber * Model.PageSize < Model.TotalCount) { <a class="btn btn-outline-secondary" asp-route-page="@(Model.PageNumber + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-projectType="@Model.ProjectType" asp-route-scheduleCategory="@Model.ScheduleCategory" asp-route-includeArchived="@Model.IncludeArchived">下一页</a> }</div></nav> }
}
