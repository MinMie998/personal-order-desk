@page "{id:guid}"
@model PersonalOrderDesk.Pages.WorkItems.DetailsModel
@using PersonalOrderDesk.Domain
@using PersonalOrderDesk.Services
@using PersonalOrderDesk.Presentation
@{
    var d = Model.Detail!;
    var w = d.WorkItem;
    var notes = WorkItemNoteSections.From(w.Notes, w.SourceKind);
    var active = w.Status is not WorkStatus.Completed and not WorkStatus.Cancelled;
    var dueDays = w.EffectiveDueDate?.DayNumber - Model.BusinessToday.DayNumber;
    var dueText = !active ? WorkLabel(w.Status) : dueDays is null ? "待补截止日期" : dueDays < 0 ? $"已逾期 {-dueDays} 天" : dueDays == 0 ? "今天到期" : $"还剩 {dueDays} 天";
    var paymentClass = d.PaymentState is "Paid" or "已收齐" or "NoPaymentRequired" or "无需收款" ? "paid" : d.OutstandingCents > 0 ? "unpaid" : "";
    var nextAction = w.Status == WorkStatus.Cancelled ? "订单已取消，可在更多操作中恢复。" : active ? (w.NextStep ?? "补充当前进度，安排下一步工作。") : d.OutstandingCents is null ? "订单金额还未确认，请先补充金额。" : d.PaymentState.Contains("超收") || d.PaymentState == "Overpaid" ? "收款超过订单金额，请核对报价与收款记录。" : d.OutstandingCents > 0 ? "制作已完成，下一步核对并记录收款。" : w.ShippingRequirement != ShippingRequirement.None && d.ShipmentStatus != ShipmentStatus.Delivered ? "制作已完成，下一步核对发货与签收情况。" : "本单工作已完成，收款已结清。";
    ViewData["Title"] = w.ProjectName;
    string WorkLabel(WorkStatus s) => s switch { WorkStatus.NotStarted => "未开始", WorkStatus.InProgress => "进行中", WorkStatus.NeedsRework => "需返工", WorkStatus.Completed => "已完成", _ => "已取消" };
    string Money(long? cents) => cents is null ? "待补金额" : $"¥{cents.Value / 100m:N2}";
    string PaymentLabel(string s) => s switch { "AmountPending" => "待补金额", "NoPaymentRequired" => "无需收款", "Unpaid" => "未收款", "PartiallyPaid" => "部分收款", "Paid" => "已收齐", "Overpaid" => "超收待核对", _ => s };
    string FulfillmentLabel(string s) => s switch { "None" => "无需快递", "NotReady" => "未到发货阶段", "PendingShipment" => "待寄出", "Paused" => "已暂停", "Shipped" => "已寄出", "Delivered" => "已签收", "HistoryReview" => "历史物流待核对", _ => s };
    string ProjectTypeLabel(ProjectType t) => t switch { ProjectType.Simulation => "仿真", ProjectType.SchematicPcbDesign => "原理图 / PCB 设计", ProjectType.CodeReport => "代码 / 报告", ProjectType.PhysicalProduction => "实物制作", ProjectType.MixedOrUnknown => "综合 / 未知", _ => "其他" };
    string ScheduleLabel(ScheduleCategory s) => s switch { ScheduleCategory.Physical => "实物工期", ScheduleCategory.Digital => "非实物工期", _ => "待确认" };
    string ShippingLabel(ShippingRequirement s) => s switch { ShippingRequirement.None => "无需快递", ShippingRequirement.Required => "需要快递", _ => "待确认" };
    string SourceLabel(ValueSource source) => source switch { ValueSource.Default => "类型默认", ValueSource.Imported => "导入值", _ => "手动设置" };
    string DueModeLabel(DueDateMode mode) => mode switch { DueDateMode.Auto => "自动", DueDateMode.Manual => "手动指定", _ => "历史日期未知" };
    DateTimeOffset BeijingTime(DateTimeOffset value)
    {
        TimeZoneInfo zone;
        try { zone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Shanghai"); }
        catch (TimeZoneNotFoundException) { zone = TimeZoneInfo.FindSystemTimeZoneById("China Standard Time"); }
        return TimeZoneInfo.ConvertTime(value, zone);
    }
}
<div class="page-heading"><div><h1>@w.ProjectName</h1><p><span class="project-number">@(w.BusinessOrderNo ?? "未填写业务编号")</span> · @ProjectTypeLabel(w.ProjectType)@if (w.IsArchived) { <span class="status-badge status-work cancelled ms-2">已归档</span> }</p></div><div class="inline-actions"><a class="btn btn-primary" asp-page="/Finance/WorkItem" asp-route-id="@w.Id">记收支</a><a class="btn btn-outline-secondary" asp-page="/WorkItems/Edit" asp-route-id="@w.Id">编辑订单</a><a class="btn btn-outline-secondary" asp-page="/WorkItems/Index">返回列表</a><a class="btn btn-outline-danger" asp-page="/WorkItems/Delete" asp-route-id="@w.Id">删除工作项</a></div></div>
@if (TempData["Notice"] is string notice) { <div class="alert alert-success" role="status">@notice</div> }
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div> }
<section class="surface order-focus mb-3">
    <div class="order-state-line"><span class="status-badge status-work @(w.Status == WorkStatus.Completed ? "completed" : w.Status == WorkStatus.InProgress ? "in-progress" : w.Status == WorkStatus.Cancelled ? "cancelled" : "")">@WorkLabel(w.Status)</span><span class="status-badge status-payment @paymentClass">@PaymentLabel(d.PaymentState)</span><span class="status-badge status-shipping @(w.ShippingRequirement == ShippingRequirement.None ? "not-required" : "")">@FulfillmentLabel(d.FulfillmentState)</span></div>
    <div class="order-next"><span class="eyebrow">@(active ? "下一步" : "当前待办")</span><p>@nextAction</p></div>
    <div class="order-facts"><div><span>订单金额</span><strong>@Money(w.OrderAmountCents)</strong></div><div><span>已收款</span><strong class="text-success">@Money(d.NetReceivedCents)</strong></div><div><span>待收金额</span><strong class="@(d.OutstandingCents > 0 ? "text-danger" : "text-success")">@Money(d.OutstandingCents)</strong></div><div><span>@(active ? "交付时限" : "工作状态")</span><strong class="@(active && dueDays <= 0 ? "text-danger" : active && dueDays <= Model.ReminderLeadDays ? "deadline-soon" : "")">@dueText</strong></div></div>
</section>
<div class="row g-3">
<div class="col-lg-8">
    <section class="surface mb-3"><div class="surface-header d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">进度与交付</h2></div><div class="surface-body">
    @if (!string.IsNullOrWhiteSpace(w.CurrentWork)) { <div class="progress-copy"><span class="eyebrow">@(active ? "当前做到" : "最后记录的进度")</span><p>@w.CurrentWork</p></div> }
    @if (active && string.IsNullOrWhiteSpace(w.CurrentWork)) { <p class="text-secondary">还没记录当前进度，补充后方便下次接着做。</p> }
    <dl class="detail-grid compact-dates"><div class="detail-item"><dt>接单日期</dt><dd>@(w.ReceivedDate?.ToString("yyyy-MM-dd") ?? "日期未知")</dd></div><div class="detail-item"><dt>截止日期</dt><dd>@(w.EffectiveDueDate?.ToString("yyyy-MM-dd") ?? "未设置")</dd></div>@if (w.Status == WorkStatus.Completed) { <div class="detail-item"><dt>完成日期</dt><dd>@(w.CompletedDateKnowledge == CompletionDateKnowledge.Known ? w.CompletedDate?.ToString("yyyy-MM-dd") : "历史日期未知")</dd></div> }</dl>
    <details class="quick-progress mt-3" open="@Model.ProgressEditorOpen"><summary>更新进度</summary><form method="post" asp-page-handler="SaveProgress" class="mt-3"><input asp-for="ProgressInput.ExpectedVersion" type="hidden"/><div class="row g-3"><div class="col-sm-6"><label asp-for="ProgressInput.CurrentWork" class="form-label">当前做到哪里</label><textarea asp-for="ProgressInput.CurrentWork" class="form-control" rows="2" maxlength="4000" placeholder="例如：电路已搭好，正在调试串口"></textarea></div><div class="col-sm-6"><label asp-for="ProgressInput.NextStep" class="form-label">下一步做什么</label><textarea asp-for="ProgressInput.NextStep" class="form-control" rows="2" maxlength="2000" placeholder="例如：联调通过后交付文件"></textarea></div></div><details class="mt-3"><summary>工程路径（选填）</summary><label asp-for="ProgressInput.ProjectPath" class="form-label mt-2">工程文件夹</label><input asp-for="ProgressInput.ProjectPath" class="form-control" maxlength="1000"/></details><button class="btn btn-primary mt-3" type="submit">保存进度</button></form></details>
    @if (w.Status is WorkStatus.NotStarted or WorkStatus.InProgress or WorkStatus.NeedsRework)
    {
        <div class="inline-actions mt-3">
        @if (w.Status != WorkStatus.InProgress) { <form method="post" asp-page-handler="ChangeStatus"><input type="hidden" name="ExpectedVersion" value="@w.Version"/><input type="hidden" name="TargetStatus" value="InProgress"/><button class="btn btn-primary" type="submit">开始进行</button></form> }
        <form method="post" asp-page-handler="ChangeStatus"><input type="hidden" name="ExpectedVersion" value="@w.Version"/><input type="hidden" name="TargetStatus" value="Completed"/><button class="btn @(w.Status == WorkStatus.InProgress ? "btn-primary" : "btn-outline-primary")" type="submit">标记完成</button></form></div>
    }
    </div></section>
    @if (!string.IsNullOrWhiteSpace(w.ProjectPath) || !string.IsNullOrWhiteSpace(notes.CurrentNotes))
    {
        <section class="surface mb-3"><div class="surface-header"><h2 class="h5 mb-0">工程与备注</h2></div><div class="surface-body">
        @if (!string.IsNullOrWhiteSpace(w.ProjectPath)) { <span class="eyebrow">工程目录</span><p class="path-value">@w.ProjectPath</p><div class="inline-actions mb-3"><button type="button" class="btn btn-sm btn-outline-secondary" id="copyDetailPath" data-path="@w.ProjectPath">复制路径</button><span id="pathStatus" class="small text-secondary" aria-live="polite" data-check-url="@Url.Page("/WorkItems/Details", "CheckPath", new { id = w.Id })" data-path="@w.ProjectPath"></span></div> }
        @if (!string.IsNullOrWhiteSpace(notes.CurrentNotes)) { <span class="eyebrow">当前备注</span><p class="note-copy mb-0">@notes.CurrentNotes</p> }
        </div></section>
    }
    @if (d.Relations.Count > 0) { <section class="surface mb-3"><div class="surface-header"><h2 class="h5 mb-0">关联订单</h2></div><div class="surface-body"><ul class="mb-0">@foreach (var relation in d.Relations) { <li><a asp-page="/WorkItems/Details" asp-route-id="@relation.RelatedWorkItemId">@relation.BusinessOrderNo · @relation.ProjectName</a> · @WorkLabel(relation.Status)</li> }</ul></div></section> }
    @if (!string.IsNullOrWhiteSpace(notes.ImportHints)) { <details class="surface mb-3 detail-fold"><summary>原表资料 · 导入时的待核提示</summary><div class="surface-body"><p class="small text-secondary">以下是导入当时保留的提示，不代表当前收款、支出或物流状态。当前状态以上方信息为准。</p><p class="note-copy mb-0">@notes.ImportHints</p></div></details> }
        @if (w.SourceKind == SourceKind.HistoricalImport && w.Status == WorkStatus.Completed && w.CompletedDateKnowledge == CompletionDateKnowledge.Unknown)
        {
            <details class="surface mb-3" id="completion-date-form"><summary class="surface-header">历史资料：补录完成日期</summary><div class="surface-body">
                <p class="text-secondary">只在能确认历史日期时补录。具体完成时间继续保留未知，原始历史和收支记录保留。</p>
                <form method="post" asp-page-handler="BackfillCompletionDate" asp-route-id="@w.Id">
                    <input type="hidden" asp-for="ExpectedVersion" />
                    <label class="form-label" asp-for="HistoricalCompletionDate">已核实的完成日期</label>
                    <input class="form-control mb-2" type="date" asp-for="HistoricalCompletionDate" required />
                    <button class="btn btn-outline-primary" type="submit">保存历史完成日期</button>
                </form>
            </div></details>
        }
        <details class="surface mb-3 detail-fold"><summary>状态历史（@d.History.Count）</summary><div class="surface-body">
            @if (d.History.Count == 0) { <p class="text-secondary mb-0">尚无状态变更记录。</p> }
            else { <ol class="history-list mb-0">@foreach (var h in d.History) { <li><strong>@WorkLabel(h.NewStatus)</strong> <span class="text-secondary">@(h.OccurredDate?.ToString("yyyy-MM-dd") ?? "发生日期未知") · 录入 @BeijingTime(h.RecordedAt).ToString("yyyy-MM-dd HH:mm")（北京时间）</span>@if (!string.IsNullOrWhiteSpace(h.Reason)) { <div>@h.Reason</div> }@if (h.PreviousCompletedDateKnowledge == CompletionDateKnowledge.Known && h.PreviousCompletedDate.HasValue) { <small class="text-secondary">此前完成日期：@h.PreviousCompletedDate?.ToString("yyyy-MM-dd")</small> }</li> }</ol> }
        </div></details>
        <details class="surface mb-3 detail-fold"><summary>操作记录（@d.Activities.Count）</summary><div class="surface-body">
            @if (d.Activities.Count == 0) { <p class="text-secondary mb-0">尚无关键操作记录。</p> }
            else { <ol class="history-list mb-0">@foreach (var activity in d.Activities) { <li><strong>@activity.Summary</strong><div class="small text-secondary">@BeijingTime(activity.RecordedAt).ToString("yyyy-MM-dd HH:mm")（北京时间）</div></li> }</ol> }
        </div></details>
<details class="surface mb-3 detail-fold"><summary>分类、日期规则与记录信息</summary><div class="surface-body"><dl class="detail-grid"><div class="detail-item"><dt>工期分类</dt><dd>@ScheduleLabel(w.ScheduleCategory)（@SourceLabel(w.ScheduleCategorySource)）</dd></div><div class="detail-item"><dt>物流需求</dt><dd>@ShippingLabel(w.ShippingRequirement)（@SourceLabel(w.ShippingRequirementSource)）</dd></div><div class="detail-item"><dt>截止日期规则</dt><dd>@DueModeLabel(w.DueDateMode)</dd></div><div class="detail-item"><dt>记录版本</dt><dd>@w.Version</dd></div></dl></div></details>
</div><div class="col-lg-4">
<section class="surface mb-3"><div class="surface-header"><h2 class="h5 mb-0">物流与交付</h2></div><div class="surface-body"><p><span class="status-badge status-shipping @(w.ShippingRequirement == ShippingRequirement.None ? "not-required" : "")">@FulfillmentLabel(d.FulfillmentState)</span></p>@if (w.ShippingRequirement != ShippingRequirement.None) { <p class="small text-secondary">@(d.FulfillmentPaused ? "发货履约已暂停。" : d.ShipmentStatus == ShipmentStatus.Delivered ? "已记录签收。" : "寄出和签收单独记录，制作完成后仍可继续更新。")</p><a class="btn btn-outline-primary" asp-page="/Shipping/Details" asp-route-id="@w.Id">查看 / 更新物流</a> } else { <p class="small text-secondary mb-0">此订单无需寄送实物。</p> }</div></section>
        <details class="surface mb-3 detail-fold" open="@(!string.IsNullOrWhiteSpace(Model.ErrorMessage))"><summary>调整状态、返工或取消</summary><div class="surface-body">
            @if (w.Status != WorkStatus.Cancelled)
            {
                <form method="post" asp-page-handler="ChangeStatus" class="mb-3">
                    <input type="hidden" name="ExpectedVersion" value="@w.Version" />
                    <label class="form-label" for="statusTarget">目标状态</label>
                    <select class="form-select mb-2" id="statusTarget" name="TargetStatus">
                        @if (w.Status == WorkStatus.NotStarted) { <option value="InProgress">开始进行</option><option value="Completed">标记完成</option> }
                        @if (w.Status == WorkStatus.InProgress) { <option value="Completed">标记完成</option><option value="NeedsRework">标记需返工</option> }
                        @if (w.Status == WorkStatus.NeedsRework) { <option value="InProgress">恢复进行</option><option value="Completed">标记完成</option> }
                        @if (w.Status == WorkStatus.Completed) { <option value="InProgress">重新打开</option><option value="NeedsRework">转为需返工</option> }
                        <option value="Cancelled">取消工作项</option>
                    </select>
                    <label class="form-label" for="statusReason">操作原因（返工或取消请填写）</label><textarea class="form-control mb-2" id="statusReason" name="Reason" rows="2"></textarea>
                    <div class="form-check mb-2" id="cancelConfirmGroup"><input class="form-check-input" type="checkbox" id="confirmCancel" name="ConfirmCancel" value="true" /><label class="form-check-label" for="confirmCancel">确认取消；历史收支与物流记录会保留</label></div>
                    <div class="form-check mb-2" id="cancelFulfillmentGroup"><input class="form-check-input" type="checkbox" id="continueCancelFulfillment" name="ContinueFulfillment" value="true" /><label class="form-check-label" for="continueCancelFulfillment">取消后仍继续履行尚未寄出的物流义务</label><div class="form-text">默认不勾选时暂停未执行的发货。</div></div>
                    <button class="btn btn-primary w-100" type="submit">执行状态操作</button>
                </form>
            }
            else
            {
                <form method="post" asp-page-handler="ChangeStatus">
                    <input type="hidden" name="ExpectedVersion" value="@w.Version" />
                    <label class="form-label" for="restoreTarget">恢复到（取消前状态未知时必须选择未完成状态）</label>
                    <select class="form-select mb-2" id="restoreTarget" name="TargetStatus" required><option value="">请选择恢复状态</option>
                        @if (w.CancelledFromStatus != CancelledStatus.Completed) { <option value="NotStarted" selected="@(w.CancelledFromStatus == CancelledStatus.NotStarted)">未开始</option><option value="InProgress" selected="@(w.CancelledFromStatus == CancelledStatus.InProgress)">进行中</option><option value="NeedsRework" selected="@(w.CancelledFromStatus == CancelledStatus.NeedsRework)">需返工</option> }
                        @if (w.CancelledFromStatus == CancelledStatus.Completed) { <option value="Completed">恢复已完成，并恢复原完成日期</option> }
                    </select><input type="hidden" name="RestoreChoice" id="restoreChoice" />
                    <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="continueFulfillment" name="ContinueFulfillment" value="true" /><label class="form-check-label" for="continueFulfillment">继续尚未完成的发货履约</label></div>
                    <label class="form-label" for="restoreReason">恢复原因（可选）</label><input class="form-control mb-2" id="restoreReason" name="Reason" />
                    <button class="btn btn-primary w-100" type="submit">恢复工作项</button>
                </form>
            }
        </div></details>
        <details class="surface detail-fold"><summary>归档与追加工作</summary><div class="surface-body">
            <p class="small text-secondary">归档只影响普通列表展示；未结清的应收和发货义务仍显示在各自待办。</p>
            <form method="post" asp-page-handler="@(w.IsArchived ? "Unarchive" : "Archive")"><input type="hidden" name="ExpectedVersion" value="@w.Version" /><button class="btn btn-outline-secondary w-100" type="submit">@(w.IsArchived ? "取消归档" : "归档工作项")</button></form>
        <a class="btn btn-outline-secondary w-100 mt-2" asp-page="/WorkItems/Create" asp-route-sourceId="@w.Id">追加工作</a></div></details>
</div></div>
@section Scripts { <script src="~/js/workitem-form.js" asp-append-version="true"></script> }
