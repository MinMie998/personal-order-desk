@page "{id:guid}"
@model PersonalOrderDesk.Pages.WorkItems.EditModel
@{
    ViewData["Title"] = "编辑工作项";
}
<div class="page-heading"><div><h1>编辑工作项</h1><p>更新进度、金额和当前备注。</p></div></div>
@if (Model.ConflictMessage is not null) { <div class="alert alert-warning" role="alert">@Model.ConflictMessage</div> }
@if (!string.IsNullOrWhiteSpace(Model.ImportedNoteHints)) { <details class="surface detail-fold mb-3"><summary>原表资料 · 导入时的待核提示</summary><div class="surface-body"><p class="small text-secondary">这些提示来自导入当时，保存当前备注时会继续保留。</p><p class="note-copy mb-0">@Model.ImportedNoteHints</p></div></details> }
<form method="post">
    <input type="hidden" name="DefaultDurationDays" value="@Model.DefaultDurationDays" />
    <partial name="_WorkItemForm" for="Input" />
    <div class="inline-actions mt-3"><button class="btn btn-primary btn-lg" type="submit">保存修改</button><a class="btn btn-outline-secondary" asp-page="/WorkItems/Details" asp-route-id="@RouteData.Values["id"]">取消</a></div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/workitem-form.js" asp-append-version="true"></script>
}
