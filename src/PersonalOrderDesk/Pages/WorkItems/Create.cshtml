@page
@model PersonalOrderDesk.Pages.WorkItems.CreateModel
@{
    ViewData["Title"] = "快速新增";
}
<div class="page-heading"><div><h1>快速新增</h1><p>先填写编号、项目名称、类型和接单日期，其他信息可稍后补充。</p></div><a class="btn btn-outline-secondary" asp-page="/WorkItems/Index">返回列表</a></div>
@if (Model.ConflictMessage is not null) { <div class="alert alert-warning" role="alert">@Model.ConflictMessage</div> }
@if (Model.SourceId.HasValue) { <div class="alert alert-info">保存后会创建独立工作项，并与原工作项建立“追加工作”关联。</div> }
<form method="post">
    @if (Model.SourceId.HasValue) { <input type="hidden" asp-for="SourceId" /> }
    <input type="hidden" name="DefaultDurationDays" value="@Model.DefaultDurationDays" />
    <partial name="_WorkItemForm" for="Input" />
    <div class="inline-actions mt-3"><button class="btn btn-primary btn-lg" type="submit">保存工作项</button><a class="btn btn-outline-secondary" asp-page="/Index">取消</a></div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/workitem-form.js" asp-append-version="true"></script>
}
