@page
@model PersonalOrderDesk.Pages.WorkItems.RecycleBinModel
@{ ViewData["Title"] = "回收站"; }
<div class="page-heading"><div><h1>回收站</h1><p>共 @Model.Items.Count 项。恢复后保留删除前的工作状态、收支、物流和追加关系；原来已归档的项目仍保持归档。</p></div><a class="btn btn-outline-secondary" asp-page="/WorkItems/Index">返回工作项</a></div>
@if (Model.ErrorMessage is not null) { <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div> }
@if (Model.Items.Count == 0) { <section class="surface"><p class="empty-state">回收站是空的。</p></section> }
else
{
<div class="surface table-responsive"><table class="table record-cards"><thead><tr><th>订单编号</th><th>项目名称</th><th>删除时间</th><th>操作</th></tr></thead><tbody>
@foreach (var item in Model.Items) { <tr><td data-label="订单编号"><span class="project-number">@(item.BusinessOrderNo ?? "未填写编号")</span></td><td data-label="项目名称">@item.ProjectName</td><td data-label="删除时间">@item.DeletedAt?.ToOffset(TimeSpan.FromHours(8)).ToString("yyyy-MM-dd HH:mm")</td><td data-label="操作"><form method="post" asp-page-handler="Restore" asp-route-id="@item.Id"><input type="hidden" name="ExpectedVersion" value="@item.Version"/><button class="btn btn-outline-primary" type="submit">恢复工作项</button></form></td></tr> }
</tbody></table></div>
}
