@model PersonalOrderDesk.Pages.WorkItems.WorkItemFormInput
@using PersonalOrderDesk.Domain
@{
    var isEdit = Model.ExpectedVersion.HasValue;
    var amountMessage = ViewData["AmountMessage"] as string;
}
<div asp-validation-summary="ModelOnly" role="alert"></div>
<section class="form-section">
    <h2>基本信息</h2>
    <div class="row g-3">
        <input asp-for="IsHistoricalImport" type="hidden" />
        <div class="col-md-4"><label asp-for="BusinessOrderNo" class="form-label"></label><input asp-for="BusinessOrderNo" class="form-control" autocomplete="off" /><span asp-validation-for="BusinessOrderNo"></span></div>
        <div class="col-md-8"><label asp-for="ProjectName" class="form-label"></label><input asp-for="ProjectName" class="form-control" autofocus /><span asp-validation-for="ProjectName"></span></div>
        <div class="col-md-6"><label asp-for="ProjectType" for="projectType" class="form-label"></label><select asp-for="ProjectType" class="form-select" id="projectType"><option value="Simulation">仿真</option><option value="SchematicPcbDesign">原理图 / PCB 设计</option><option value="CodeReport">代码 / 报告</option><option value="PhysicalProduction">实物制作</option><option value="Other">其他</option><option value="MixedOrUnknown">综合 / 未知</option></select></div>
        <div class="col-md-6"><label asp-for="ReceivedDate" class="form-label"></label><input asp-for="ReceivedDate" type="date" class="form-control" /><div class="form-text">按业务日期保存；修改后自动截止日由系统重算。</div><span asp-validation-for="ReceivedDate"></span></div>
        @if (isEdit)
        {
            <input asp-for="ExpectedVersion" type="hidden" />
            <div class="col-md-6"><label asp-for="ScheduleCategory" class="form-label">工期类型覆盖</label><select asp-for="ScheduleCategory" class="form-select"><option value="">保持当前值</option><option value="Physical">实物工期</option><option value="Digital">非实物工期</option><option value="Pending">待确认</option></select><div class="form-text">留空保留当前工期分类及来源。</div></div>
            <div class="col-md-6"><label asp-for="ShippingRequirement" class="form-label">物流需求覆盖</label><select asp-for="ShippingRequirement" class="form-select"><option value="">保持当前值</option><option value="None">无需快递</option><option value="Required">需要快递</option><option value="Pending">待确认</option></select><div class="form-text">留空保留当前需求及来源。</div></div>
            <div class="col-12"><label asp-for="ApplyProjectTypeDefaults" class="form-label">项目类型变化时如何处理默认值</label><select asp-for="ApplyProjectTypeDefaults" class="form-select"><option value="">如果改变了项目类型，请选择处理方式</option><option value="true">应用新类型的工期和物流默认值</option><option value="false">保留现有工期和物流值</option></select><div class="form-text">只有明确选择后才处理类型默认值；未更改项目类型时可保持未选择。</div></div>
        }
        else
        {
            <div class="col-md-6"><label asp-for="ScheduleCategory" class="form-label">工期分类</label><select asp-for="ScheduleCategory" class="form-select"><option value="">按项目类型默认</option><option value="Physical">实物工期</option><option value="Digital">非实物工期</option><option value="Pending">待确认</option></select><div class="form-text">留空即按项目类型映射默认工期。</div></div>
            <div class="col-md-6"><label asp-for="ShippingRequirement" class="form-label">物流需求</label><select asp-for="ShippingRequirement" class="form-select"><option value="">按项目类型默认</option><option value="None">无需快递</option><option value="Required">需要快递</option><option value="Pending">待确认</option></select><div class="form-text">留空即按项目类型映射默认物流需求。</div></div>
        }
    </div>
</section>
<section class="form-section">
    <h2>截止日期与金额</h2>
    <div class="row g-3">
        <div class="col-md-5"><label asp-for="DueDateMode" for="dueMode" class="form-label"></label><select asp-for="DueDateMode" class="form-select" id="dueMode"><option value="Auto">自动计算</option><option value="Manual">手动指定</option>@if (Model.IsHistoricalImport) { <option value="HistoricalUnknown">历史日期未知</option> }</select><div class="form-text">清空手工截止日期后会自动切回 Auto；历史导入记录可继续保留“历史日期未知”。</div></div>
        <div class="col-md-4" id="specifiedDateGroup"><label asp-for="SpecifiedDueDate" class="form-label"></label><input asp-for="SpecifiedDueDate" type="date" class="form-control" /><span asp-validation-for="SpecifiedDueDate"></span></div>
        <div class="col-md-3"><label asp-for="OrderAmount" class="form-label"></label><div class="input-group"><input asp-for="OrderAmount" type="number" min="0" step="0.01" class="form-control" /><span class="input-group-text">元</span></div><div class="form-text">金额未知请留空，0 元与未知金额不同。</div><span asp-validation-for="OrderAmount"></span></div>
        <div class="col-12"><div class="form-text" id="dueDatePreview" data-default-days="@(ViewData["DefaultDurationDays"])" aria-live="polite">截止日期预览会随输入更新；最终日期以保存后的服务结果为准。</div></div>
        @if (isEdit)
        {
            <div class="col-12"><label asp-for="OrderAmountChangeReason" class="form-label"></label><input asp-for="OrderAmountChangeReason" class="form-control" placeholder="仅金额发生变化时必填" /><span asp-validation-for="OrderAmountChangeReason"></span>@if (!string.IsNullOrEmpty(amountMessage)) { <div class="form-text">@amountMessage</div> }</div>
        }
    </div>
</section>
<details class="advanced-fields" id="progress-fields" open="@isEdit">
    <summary>进度与工程资料（可选）</summary>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="CurrentWork" class="form-label"></label><textarea asp-for="CurrentWork" class="form-control" rows="3"></textarea><span asp-validation-for="CurrentWork"></span></div>
        <div class="col-md-6"><label asp-for="NextStep" class="form-label"></label><textarea asp-for="NextStep" class="form-control" rows="3"></textarea><span asp-validation-for="NextStep"></span></div>
        <div class="col-12"><label asp-for="ProjectPath" for="projectPath" class="form-label"></label><div class="input-group"><input asp-for="ProjectPath" class="form-control" id="projectPath" /><button type="button" class="btn btn-outline-secondary" id="checkPath">检查路径</button><button type="button" class="btn btn-outline-secondary" id="copyPath">复制路径</button></div><div class="form-text" id="pathCheckMessage" aria-live="polite">路径不可访问只提示，不会阻止保存工作项。</div><span asp-validation-for="ProjectPath"></span></div>
        <div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3"></textarea><span asp-validation-for="Notes"></span></div>
    </div>
</details>
