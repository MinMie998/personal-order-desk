@page
@model PersonalOrderDesk.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "设置与备份";
}
<div class="page-heading"><div><h1>设置与备份</h1><p>提醒、默认工期和本地数据库备份。</p></div></div>
<p class="inline-actions"><a class="btn btn-outline-primary" asp-page="/Settings/Network">手机与局域网</a><a class="btn btn-outline-secondary" asp-page="/Settings/DataTransfer">数据迁移与导出</a></p>
@if (!string.IsNullOrWhiteSpace(Model.Notice)) { <div class="alert alert-success" role="status">@Model.Notice</div> }
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div> }
<div asp-validation-summary="ModelOnly" role="alert"></div>
<section class="surface mb-3"><div class="surface-header"><h2 class="h5 mb-0">默认工期与提醒</h2></div><div class="surface-body">
    <form method="post" asp-page-handler="Save">
        <input asp-for="Settings.Version" type="hidden" />
        <input asp-for="Settings.AffectedAutomaticDueDateCount" type="hidden" />
        <div class="row g-3">
            <div class="col-md-4"><label asp-for="Settings.NonPhysicalDefaultDurationDays" class="form-label">非实物默认工期（自然日）</label><input asp-for="Settings.NonPhysicalDefaultDurationDays" type="number" min="1" class="form-control" /><div class="form-text">只影响 Auto 模式；手工指定和历史未知截止日期保持不变。</div></div>
            <div class="col-md-4"><label asp-for="Settings.PhysicalReminderLeadDays" class="form-label">实物提前提醒天数</label><input asp-for="Settings.PhysicalReminderLeadDays" type="number" min="0" class="form-control" /><div class="form-text">默认 7 天；设置为 0 时仍显示今日到期和逾期。</div></div>
            <div class="col-md-4"><label asp-for="Settings.DigitalReminderLeadDays" class="form-label">非实物提前提醒天数</label><input asp-for="Settings.DigitalReminderLeadDays" type="number" min="0" class="form-control" /><div class="form-text">默认 1 天。</div></div>
            <div class="col-md-8"><label asp-for="Settings.BackupDirectory" class="form-label">默认备份目录</label><input asp-for="Settings.BackupDirectory" class="form-control" /><div class="form-text">留空时由服务决定默认位置。</div></div>
            <div class="col-md-4"><label asp-for="Settings.BackupRetentionDays" class="form-label">备份保留天数</label><input asp-for="Settings.BackupRetentionDays" type="number" min="1" class="form-control" /></div>
        </div>
        @if (Model.Settings.AffectedAutomaticDueDateCount > 0)
        {
            <div class="alert alert-warning mt-3 mb-0"><strong>工期变更影响提示：</strong> 当前约有 @Model.Settings.AffectedAutomaticDueDateCount 项 Auto 工作项将按新天数重算。</div>
        }
        <div class="form-check mt-3"><input asp-for="ConfirmAutomaticDateRecalculation" class="form-check-input" /><label asp-for="ConfirmAutomaticDateRecalculation" class="form-check-label">我已确认修改默认工期可能重算对应 Auto 截止日期</label></div>
        <div class="mt-3"><button class="btn btn-primary" type="submit">保存设置</button></div>
    </form>
</div></section>
<section class="surface mt-3"><div class="surface-header"><h2 class="h5 mb-0">数据位置、备份与恢复</h2></div><div class="surface-body">
    @if (Model.MaintenanceStatus is not null)
    {
        <p>数据目录：<code class="path-value">@Model.MaintenanceStatus.DataDirectory</code></p>
        <p>数据库：<code class="path-value">@Model.MaintenanceStatus.DatabasePath</code></p>
        @if (!string.IsNullOrWhiteSpace(Model.MaintenanceStatus.Message)) { <p class="text-secondary">@Model.MaintenanceStatus.Message</p> }
    }
    <p class="text-secondary">备份可恢复应用数据。恢复前系统会先制作一份当前数据的保护备份；请确认来源和内容后再执行。Excel 导出是查看报告，不是备份。</p>
    <form method="post" asp-page-handler="CreateBackup"><button class="btn btn-outline-primary" type="submit">立即创建备份</button></form>
    @if (Model.Backups.Count > 0)
    {
        <h3 class="h6 mt-4">可用备份</h3><div class="table-responsive"><table class="table"><thead><tr><th>文件</th><th>修改时间</th><th>大小</th><th>检查</th><th></th></tr></thead><tbody>
        @foreach (var backup in Model.Backups)
        {
            <tr><td class="path-value">@backup.Path</td><td>@backup.LastWriteTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td>@(backup.SizeBytes / 1024) KB</td><td>@(backup.IsValid ? "可预览" : backup.Message ?? "无法使用")</td><td>
                @if (backup.IsValid) { <form method="post" asp-page-handler="PreviewRestore"><input type="hidden" name="RestoreBackupPath" value="@backup.Path" /><button class="btn btn-sm btn-outline-primary" type="submit">预览恢复</button></form> }
            </td></tr>
        }
        </tbody></table></div>
    }
    <form method="post" asp-page-handler="PreviewRestore" class="mt-3"><label asp-for="RestoreBackupPath" class="form-label">或输入备份文件完整路径</label><div class="input-group"><input asp-for="RestoreBackupPath" class="form-control" /><button class="btn btn-outline-primary" type="submit">检查并预览</button></div></form>
    @if (Model.RestorePreview is not null)
    {
        <div class="alert @(Model.RestorePreview.CanRestore ? "alert-warning" : "alert-danger") mt-3" role="status">
            <h3 class="h6">恢复预览</h3><p>@Model.RestorePreview.Message</p>
            <p>应用身份：@(Model.RestorePreview.BackupApplicationId ?? "无法确认")；数据版本：@(Model.RestorePreview.BackupSchemaVersion ?? "无法确认")</p>
            <p>文件完整性：@(Model.RestorePreview.IntegrityCheckPassed ? "通过" : "未通过")；关联检查：@(Model.RestorePreview.ForeignKeyCheckPassed ? "通过" : "未通过")</p>
            @if (Model.RestorePreview.CanRestore && !string.IsNullOrWhiteSpace(Model.RestoreConfirmationToken))
            {
                <p><strong>确认后将用此备份替换当前工作数据，当前数据会先另存为保护备份。</strong> 请先确认备份来源正确，并确保当前页面操作已保存。</p>
                <form method="post" asp-page-handler="Restore"><input type="hidden" asp-for="RestoreBackupPath" value="@Model.RestorePreview.BackupPath" /><input type="hidden" asp-for="RestoreConfirmationToken" value="@Model.RestoreConfirmationToken" /><div class="form-check mb-2"><input asp-for="ConfirmRestore" class="form-check-input" required /><label asp-for="ConfirmRestore" class="form-check-label">我已了解：确认后将切换到预览中的备份数据</label></div><button class="btn btn-danger" type="submit">确认恢复</button></form>
            }
        </div>
    }
</div></section>
<section class="surface mt-3"><div class="surface-header"><h2 class="h5 mb-0">退出应用</h2></div><div class="surface-body"><p class="text-secondary">退出会停止本机工作台服务；浏览器关闭不会自动退出。再次使用时请从启动入口打开应用。</p><form method="post" asp-page-handler="Exit"><button class="btn btn-outline-danger" type="submit">退出应用</button></form></div></section>
