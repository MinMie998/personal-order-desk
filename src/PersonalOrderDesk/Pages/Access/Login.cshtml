@page
@model PersonalOrderDesk.Pages.Access.LoginModel
@{ ViewData["Title"] = "登录工作台"; }
<section class="surface login-panel">
    <div class="surface-body">
        <span class="status-badge status-shipping">局域网访问</span>
        <h1 class="mt-3">登录个人工作台</h1>
        <p class="text-secondary">输入在电脑上设置的密码，继续处理订单。</p>
        @if (Model.ErrorMessage is not null) { <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div> }
        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <label asp-for="Password" class="form-label">登录密码</label>
            <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" required maxlength="128" />
            <button class="btn btn-primary w-100 mt-3" type="submit">登录工作台</button>
        </form>
        <p class="form-text mt-3">忘记密码时，请在电脑本机的“手机与局域网”中重新设置。</p>
    </div>
</section>
