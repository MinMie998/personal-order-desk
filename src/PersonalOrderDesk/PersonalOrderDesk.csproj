  <ItemGroup><ProjectReference Include="../PersonalOrderDesk.Core/PersonalOrderDesk.Core.csproj" /><ProjectReference Include="../PersonalOrderDesk.SharedUI/PersonalOrderDesk.SharedUI.csproj" /></ItemGroup>

