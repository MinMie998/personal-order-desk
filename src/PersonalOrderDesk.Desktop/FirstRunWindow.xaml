<Window x:Class="PersonalOrderDesk.Desktop.FirstRunWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="欢迎使用个人接单工作台" Width="620" Height="440" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#F5F7FA" FontFamily="Microsoft YaHei UI" FontSize="14">
  <StackPanel Margin="30">
    <TextBlock Text="先为账本选个位置" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <TextBlock Text="无需安装或配置数据库。默认位置适合日常使用，也可以选择自己的数据文件夹。程序升级后继续使用这里的账本。" TextWrapping="Wrap" Foreground="#667085" Margin="0,0,0,22"/>
    <TextBlock Text="数据文件夹" Margin="0,0,0,7"/>
    <DockPanel><Button Content="选择文件夹" DockPanel.Dock="Right" Padding="10,7" Margin="8,0,0,0" Click="Browse"/><TextBox x:Name="Folder" Padding="8" VerticalContentAlignment="Center"/></DockPanel>
    <TextBlock Text="已有账本：请选择包含 app.db 的原数据文件夹。订单、收支和备份会保留。不要把个人数据库放进公开仓库。" TextWrapping="Wrap" Foreground="#667085" Margin="0,14,0,0"/>
    <TextBlock x:Name="Error" TextWrapping="Wrap" Foreground="#B42332" Margin="0,12,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="取消" Padding="18,8" Margin="0,0,10,0" IsCancel="True"/><Button Content="确认位置并打开" Padding="18,8" Background="#365EE8" Foreground="White" IsDefault="True" Click="Confirm"/></StackPanel>
  </StackPanel>
</Window>
