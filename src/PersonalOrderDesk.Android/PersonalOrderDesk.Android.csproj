<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework><OutputType>Exe</OutputType>
    <RootNamespace>PersonalOrderDesk.Android</RootNamespace><UseMaui>true</UseMaui><SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><EnableDefaultCssItems>false</EnableDefaultCssItems>
    <ApplicationTitle>个人接单工作台</ApplicationTitle><ApplicationId>com.personalorderdesk.app</ApplicationId>
    <ApplicationDisplayVersion>2.0.0-preview.1</ApplicationDisplayVersion><ApplicationVersion>20</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion><PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation><AndroidEnableProfiledAot>false</AndroidEnableProfiledAot><AndroidPackageFormats>apk</AndroidPackageFormats>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F5F7FA" BaseSize="128,128" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="..\PersonalOrderDesk.SharedUI\PersonalOrderDesk.SharedUI.csproj" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
  </ItemGroup>
</Project>
