<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PersonalOrderDesk.Android"
             xmlns:shared="clr-namespace:PersonalOrderDesk.SharedUI;assembly=PersonalOrderDesk.SharedUI"
             x:Class="PersonalOrderDesk.Android.MainPage">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type shared:WorkbenchShell}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
